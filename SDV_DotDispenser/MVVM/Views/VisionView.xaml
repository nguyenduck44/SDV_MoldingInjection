<UserControl x:Class="SDV_DotDispenser.MVVM.Views.VisionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_DotDispenser.MVVM.Views"
             mc:Ignorable="d"
             x:Name="root"
             xmlns:visionUI="clr-namespace:EQX.VisionUI.WPF.Controls;assembly=EQX.VisionUI.WPF"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <TabControl>
        <TabItem Header="Align">
            <visionUI:FlowView VisionFlow="{Binding DataContext.AlignFlow,ElementName=root}"
                               ToolList="{Binding DataContext.VisionTools,ElementName=root}"
                               LoadCommand="{Binding DataContext.LoadFlowCommand,ElementName=root}"
                               SaveCommand="{Binding DataContext.SaveFlowCommand,ElementName=root}" />
        </TabItem>
        <TabItem Header="Inspect">
            
        </TabItem>
    </TabControl>
</UserControl>
