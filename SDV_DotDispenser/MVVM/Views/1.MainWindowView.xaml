<Window x:Class="SDV_DotDispenser.MVVM.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDV_DotDispenser.MVVM.Views"
        xmlns:vm="clr-namespace:SDV_DotDispenser.MVVM.ViewModels"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="/EQX.UI;component/Resources/Images/TopIcon.ico"
        AllowsTransparency="True"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Title="MainWindowView">
    <Grid>
        <DockPanel Margin="7 0">
            <Grid Height="11.5"
                  DockPanel.Dock="Bottom"
                  Background="{StaticResource PrimaryBackgroundColor}" />
            <ContentControl Content="{Binding HeaderVM}"
                            DockPanel.Dock="Top"
                            Height="Auto" />
            <ContentControl Content="{Binding FooterVM}"
                            DockPanel.Dock="Bottom" />

            <ContentControl Content="{Binding CurrentFrameVM}" />
            
        </DockPanel>
    </Grid>
</Window>
