<UserControl x:Class="SDV_DotDispenser.MVVM.Views.TeachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_DotDispenser.MVVM.Views"
             xmlns:cvt="clr-namespace:SDV_DotDispenser.Converters"
             xmlns:vm="clr-namespace:SDV_DotDispenser.MVVM.ViewModels"
             mc:Ignorable="d"
             Loaded="root_Loaded"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:TeachViewModel}"
             x:Name="root">
    <UserControl.Resources>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource AutoWidthTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True"
                              KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Header trong cột tab -->
                            <Border Grid.Column="0"
                                    Grid.Row="0"
                                    Background="Transparent"
                                    Padding="10,8"
                                    Margin="0,0,0,5">
                                <TextBlock Text="Unit"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="Black"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <!-- Tab items -->
                            <UniformGrid Columns="1"
                                         Rows="20"
                                         IsItemsHost="True"
                                         Grid.Column="0"
                                         Grid.Row="1" />

                            <!-- Content area -->
                            <Border Grid.Column="1"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    KeyboardNavigation.DirectionalNavigation="Contained">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <ItemsControl ItemsSource="{Binding TeachingUnits}"
                          DockPanel.Dock="Left"
                          Width="200">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Content="{Binding Name}"
                                     Command="{Binding DataContext.GetTeachingUnitViewModel, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                                     CommandParameter="{Binding .}"
                                     GroupName="MANUAL_UNIT_RADIOBUTTON"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     Style="{StaticResource ButtonLikeRadioButtonStyle}">
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ContentControl Content="{Binding SelectedTeachingUnit}"
                            IsEnabled="{Binding MachineStatus.IsStandByProcessMode}" />
        </DockPanel>
    </Grid>

</UserControl>