<UserControl x:Class="SDV_DotDispenser.MVVM.Views.OriginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_DotDispenser.MVVM.Views"
             mc:Ignorable="d"
             x:Name="root"
             Loaded="root_Loaded"
             xmlns:ui="clr-namespace:EQX.UI.Controls;assembly=EQX.UI"
             xmlns:process="clr-namespace:EQX.Process;assembly=EQX.Process"
             xmlns:vm="clr-namespace:SDV_DotDispenser.MVVM.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type vm:OriginViewModel}}"
             d:DesignHeight="1080"
             d:DesignWidth="1920">
    <UserControl.Resources>
        <DataTemplate x:Key="ProcessOriginStatusTemplate">
            <Border BorderBrush="Gray"
                    IsEnabled="{Binding DataContext.MachineStatus.IsStandByProcessMode,ElementName=root}"
                    Cursor="Hand"
                    BorderThickness="1"
                    PreviewMouseDown="Border_PreviewMouseDown">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Label Content="{Binding Name}"
                           FontWeight="Bold"
                           FontSize="14"
                           HorizontalContentAlignment="Center"
                           Foreground="White">
                        <Label.Style>
                            <Style TargetType="{x:Type Label}"
                                   BasedOn="{StaticResource {x:Type Label}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOriginOrInitSelected}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="#2196F3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOriginOrInitSelected}"
                                                 Value="False">
                                        <Setter Property="Background"
                                                Value="Black" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>
                    <Label Grid.Row="1"
                           FontWeight="SemiBold"
                           HorizontalContentAlignment="Center">
                        <Label.Style>
                            <Style TargetType="{x:Type Label}"
                                   BasedOn="{StaticResource {x:Type Label}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlarm}"
                                                 Value="True">
                                        <Setter Property="Content"
                                                Value="Alarm,Need Origin" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAlarm}"
                                                 Value="False">
                                        <Setter Property="Content"
                                                Value="Origin Done" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAlarm}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="OrangeRed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAlarm}"
                                                 Value="False">
                                        <Setter Property="Background"
                                                Value="GreenYellow" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>
                </Grid>
            </Border>
        </DataTemplate>
        <Style TargetType="ContentControl">
            <Style.Setters>
                <Setter Property="ContentTemplate"
                        Value="{StaticResource ProcessOriginStatusTemplate}" />
            </Style.Setters>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="9*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Canvas Grid.Row="0">
            <ContentControl Content="{Binding Processes.TransferProcess}"
                            Canvas.Left="20"
                            Canvas.Top="550" />
            <ContentControl Content="{Binding Processes.ShuttleProcess}"
                            Canvas.Left="200"
                            Canvas.Top="550" />
        </Canvas>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Height="50"
                    Grid.Row="1">
            <ui:ImageButton Content="{DynamicResource str_Select_all}"
                            Image="/EQX.UI;component/Resources/Images/Components/Common/select_selected.png"
                            Command="{Binding SelectAllCommand}"
                            IsEnabled="{Binding MachineStatus.IsStandByProcessMode}"
                            FontSize="20"
                            Margin="0 0 5 0"
                            Width="200" />
            <ui:ImageButton Content="{DynamicResource str_Unselect_all}"
                            Image="/EQX.UI;component/Resources/Images/Components/Common/unselect_all_selected.png"
                            Command="{Binding UnSelectAllCommand}"
                            IsEnabled="{Binding MachineStatus.IsStandByProcessMode}"
                            FontSize="20"
                            Margin="0 0 5 0"
                            Width="200" />
            <ui:ImageButton Content="{DynamicResource str_Origin}"
                            Image="/EQX.UI;component/Resources/Images/Components/Common/return origin_selected.png"
                            Command="{Binding OriginCommand}"
                            IsEnabled="{Binding MachineStatus.IsStandByProcessMode}"
                            FontSize="20"
                            Margin="0 0 5 0"
                            Width="200" />
            <ui:ImageButton Content="{DynamicResource str_Stop}"
                            Image="/EQX.UI;component/Resources/Images/Components/Common/stop_selected.png"
                            Command="{Binding StopCommand}"
                            FontSize="20"
                            Margin="0 0 5 0"
                            Width="200" />
            <ui:ImageButton Content="{DynamicResource str_Exit}"
                            Image="/EQX.UI;component/Resources/Images/Components/Common/exit_selected.png"
                            Command="{Binding ExitCommand}"
                            FontSize="20"
                            Width="200" />
        </StackPanel>
    </Grid>
</UserControl>
