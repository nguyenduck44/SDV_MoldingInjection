<Application x:Class="SDV_MoldingInjection.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             xmlns:views="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             xmlns:cvt="clr-namespace:SDV_MoldingInjection.Converters"
             xmlns:uiCvt="clr-namespace:EQX.UI.Converters;assembly=EQX.UI"
             xmlns:inout="clr-namespace:EQX.InOut;assembly=EQX.InOut"
             xmlns:viewsLib="clr-namespace:EQX.UI.Controls;assembly=EQX.UI"
             xmlns:uiMVVM="clr-namespace:EQX.UI.MVVM;assembly=EQX.UI"
             xmlns:local="clr-namespace:SDV_MoldingInjection"
             xmlns:define="clr-namespace:SDV_MoldingInjection.Defines"
             xmlns:controls="clr-namespace:SDV_MoldingInjection.Controls"
             xmlns:devices="clr-namespace:SDV_MoldingInjection.Defines.Devices"
             xmlns:services="clr-namespace:SDV_MoldingInjection.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/EQX.UI;component/Resources/Themes/SamsungTheme.xaml" />
                <ResourceDictionary Source="/EQX.UI;component/Resources/Themes/Additional/SDVTheme.xaml" />
                <ResourceDictionary Source="/EQX.UI;component/Generic.xaml" />

                <ResourceDictionary Source="/EQX.UI;component/Resources/Language/KoreanLanguage.xaml" />
                <ResourceDictionary Source="/EQX.UI;component/Resources/Language/VietnameseLanguage.xaml" />
                <ResourceDictionary Source="/EQX.UI;component/Resources/Language/ChineseLanguage.xaml" />
                <ResourceDictionary Source="/EQX.UI;component/Resources/Language/EnglishLanguage.xaml" />
                <ResourceDictionary Source="/EQX.UI;component/Styles/TextBox/TextBoxWithNameLeftStyle.xaml" />
                <ResourceDictionary Source="/Styles/DataGridCellStyles.xaml" />
                <ResourceDictionary Source="/Styles/TextBlockHeaderGroupBoxStyle.xaml" />
                <ResourceDictionary Source="/Styles/AutoWidthTabItemStyle.xaml" />
                <ResourceDictionary Source="/EQX.UI;component/Styles/RadioButton/ButtonLikeRadioButtonStyle.xaml" />

                <ResourceDictionary Source="/SDV_MoldingInjection;component/Resource/Language/KoreanLanguage.xaml" />
                <ResourceDictionary Source="/SDV_MoldingInjection;component/Resource/Language/VietnameseLanguage.xaml" />
                <ResourceDictionary Source="/SDV_MoldingInjection;component/Resource/Language/ChineseLanguage.xaml" />
                <ResourceDictionary Source="/SDV_MoldingInjection;component/Resource/Language/EnglishLanguage.xaml" />

                <ResourceDictionary>
                    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                    <uiCvt:BooleanOrToVisibilityConverter x:Key="BooleanOrToVisibilityConverter"/>
                    <uiCvt:CylinderButtonBrushConverter x:Key="CylinderButtonBrushConverter"/>
                    <cvt:UserPermissionToVisibilityConverter x:Key="UserPermissionToVisibilityConverter"/>
                    <uiCvt:CylinderTypeToButtonNameConverter x:Key="CylinderTypeToButtonNameConverter"/>
                    <cvt:ObjectSelectedConverter x:Key="ObjectSelectedConverter"/>
                    <uiCvt:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
                    <uiCvt:DoorStatusToBrushConverterRevers x:Key="DoorStatusToBrushConverterRevers"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:FooterViewModel}">
                <views:FooterView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HeaderViewModel}">
                <views:HeaderView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RightPanelViewModel}">
                <views:RightPanelView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NavigateMenuViewModel}">
                <views:NavigateMenuView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type uiMVVM:CIMHostMessageViewModelBase}">
                <uiMVVM:CIMHostMessageView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:InitDeinitViewModel}">
                <views:InitDeinitView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OriginViewModel}">
                <views:OriginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AutoViewModel}">
                <views:AutoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type define:CarrierJigStatus}">
                <controls:CarrierJigStatusView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DataViewModel}">
                <views:DataView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RecipeViewModel}">
                <views:RecipeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MotionsConfigViewModel}">
                <views:MotionsConfigView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdditionalMoldingViewModel}">
                <views:AdditionalMoldingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OptionViewModel}">
                <views:OptionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MaterialPortsViewModel}">
                <views:MaterialPortsView />
            </DataTemplate>

            <!-- MAINTENANCE DATATEMPLATE -->
            <DataTemplate x:Key="InjectManualView">
                <views:InjectManualView />
            </DataTemplate>
            <DataTemplate x:Key="DryPumpManualView">
                <views:DryPumpManualView />
            </DataTemplate>
            <DataTemplate x:Key="SPDHeadManualView">
                <views:SPDHeadManualView />
            </DataTemplate>

            <DataTemplate x:Key="InjectTeachView">
                <views:InjectTeachView />
            </DataTemplate>
            <DataTemplate x:Key="DryPumpTeachView">
                <views:DryPumpTeachView />
            </DataTemplate>
            <DataTemplate x:Key="SPDHeadTeachView">
                <views:SPDHeadTeachView />
            </DataTemplate>

            <services:MaintenaceViewSelector x:Key="InjectMaintenanceViewSelector"
                                             ManualViewTemplate="{StaticResource InjectManualView}"
                                             TeachViewTemplate="{StaticResource InjectTeachView}" />
            <services:MaintenaceViewSelector x:Key="DryPumpMaintenanceViewSelector"
                                             ManualViewTemplate="{StaticResource DryPumpManualView}"
                                             TeachViewTemplate="{StaticResource DryPumpTeachView}" />
            <services:MaintenaceViewSelector x:Key="SPDHeadMaintenanceViewSelector"
                                             ManualViewTemplate="{StaticResource SPDHeadManualView}"
                                             TeachViewTemplate="{StaticResource SPDHeadTeachView}" />

            <DataTemplate DataType="{x:Type vm:ManualViewModel}">
                <views:ManualView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TeachViewModel}">
                <views:TeachView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DryPumpMaintenanceViewModel}">
                <ContentControl Content="{Binding .}"
                                ContentTemplateSelector="{StaticResource DryPumpMaintenanceViewSelector}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InjectMaintenanceViewModel}">
                <ContentControl Content="{Binding .}"
                                ContentTemplateSelector="{StaticResource InjectMaintenanceViewSelector}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SPDHeadMaintenanceViewModel}">
                <ContentControl Content="{Binding .}"
                                ContentTemplateSelector="{StaticResource SPDHeadMaintenanceViewSelector}" />
            </DataTemplate>

            <!-- MONITOR DATATEMPLATE -->
            <DataTemplate DataType="{x:Type vm:MonitorIOViewModel}">
                <views:MonitorIOView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MonitorMotionViewModel}">
                <views:MonitorMotionView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DevViewModel}">
                <views:DevView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogViewModel}">
                <views:LogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
                <views:MonitorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type devices:SyringeAmountStatus}">
                <controls:SyringeUnitView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type inout:CylinderBase}">
                <viewsLib:CylinderSimpleView />
            </DataTemplate>
            <!-- TODO: CIM -->
            <DataTemplate DataType="{x:Type uiMVVM:MaterialPort}">
                <uiMVVM:MaterialPortView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CIMTestViewModel}">
                <views:CIMTestView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
