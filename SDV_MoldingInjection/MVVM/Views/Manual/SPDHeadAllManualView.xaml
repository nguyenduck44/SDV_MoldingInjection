<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.SPDHeadAllManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type vm:SPDHeadAllMaintenanceViewModel}}"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextAlignment"
                    Value="Center" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="FontSize"
                    Value="15" />
        </Style>
    </UserControl.Resources>
    <GroupBox Header="SPDHead Groups">
        <Grid Margin="5 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <UniformGrid Columns="4"
                             VerticalAlignment="Center">
                    <TextBlock Text="HEAD1" />
                    <TextBlock Text="HEAD2" />
                    <TextBlock Text="HEAD3" />
                    <TextBlock Text="HEAD4" />
                </UniformGrid>
                <UniformGrid Grid.Row="1"
                             Columns="4">
                    <Button Margin="0,0,0,4"
                            Command="{Binding SelectHeadCommand}"
                            CommandParameter="1"
                            Content="{Binding MachineStatus.IsSkipHead1, Converter={StaticResource HeadSkipStatusTextConverter}}"
                            Background="{Binding MachineStatus.IsSkipHead1, Converter={StaticResource HeadSkipStatusBrushConverter}}"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold">
                    </Button>
                    <Button Margin="0,0,0,4"
                            Command="{Binding SelectHeadCommand}"
                            CommandParameter="2"
                            Content="{Binding MachineStatus.IsSkipHead2, Converter={StaticResource HeadSkipStatusTextConverter}}"
                            Background="{Binding MachineStatus.IsSkipHead2, Converter={StaticResource HeadSkipStatusBrushConverter}}"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold">
                    </Button>
                    <Button Margin="0,0,0,4"
                            Command="{Binding SelectHeadCommand}"
                            CommandParameter="3"
                            Content="{Binding MachineStatus.IsSkipHead3, Converter={StaticResource HeadSkipStatusTextConverter}}"
                            Background="{Binding MachineStatus.IsSkipHead3, Converter={StaticResource HeadSkipStatusBrushConverter}}"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold">
                    </Button>
                    <Button Margin="0,0,0,4"
                            Command="{Binding SelectHeadCommand}"
                            CommandParameter="4"
                            Content="{Binding MachineStatus.IsSkipHead4, Converter={StaticResource HeadSkipStatusTextConverter}}"
                            Background="{Binding MachineStatus.IsSkipHead4, Converter={StaticResource HeadSkipStatusBrushConverter}}"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold">
                    </Button>
                </UniformGrid>
            </Grid>

            <GroupBox Grid.Row="1"
                      Style="{StaticResource TextBlockHeaderGroupBox}"
                      Header="Function">
                <UniformGrid Columns="2">
                    <Button Content="Skip Calibration"
                            Margin="2 5"
                            Command="{Binding SkipCalCommand}" />
                    <CheckBox IsChecked="{Binding MachineStatus.IsDotWeightingTest}"
                              Margin="0 5"
                              Content="Dot Weighting Re-Check"
                              Tag="Check to Ignore Calibration Dot Weighting" />
                </UniformGrid>
            </GroupBox>

            <GroupBox Grid.Row="2"
                      Style="{StaticResource TextBlockHeaderGroupBox}"
                      FontSize="14"
                      Margin="0 5"
                      FontWeight="Bold"
                      Header="Semi Sequences">
                <ItemsControl ItemsSource="{Binding Sequences}"
                              DisplayMemberPath="">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"
                                         VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="3"
                                    Height="50"
                                    Content="{Binding ., Converter={StaticResource EnumDescriptionConverter}}"
                                    Command="{Binding DataContext.SemiSequenceButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <GroupBox Header="Balance Monitor"
                      Grid.Row="0"
                      Grid.Column="1"
                      Margin="10 4"
                      Style="{StaticResource TextBlockHeaderGroupBox}">
                <UniformGrid Columns="2">
                    <Border Margin="5"
                            Background="#F8F9FA"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#DEE2E6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="LEFT UNIT"
                                       FontSize="11"
                                       Foreground="#6C757D"
                                       HorizontalAlignment="Left" />

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,10">
                                <TextBlock Text="{Binding BalanceLeftStableWeight, StringFormat='{}{0:0.###}'}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#212529" />
                                <TextBlock Text=" mg"
                                           FontSize="14"
                                           Foreground="#ADB5BD"
                                           VerticalAlignment="Bottom"
                                           Margin="4,0,0,4" />
                            </StackPanel>

                            <Button Grid.Row="2"
                                    Content="SET ZERO"
                                    Height="35"
                                    Background="#495057"
                                    Foreground="White"
                                    FontSize="12"
                                    Command="{Binding BalanceLeftSetZeroCommand}">
                            </Button>
                        </Grid>
                    </Border>

                    <Border Margin="5"
                            Background="#F8F9FA"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="#DEE2E6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="RIGHT UNIT"
                                       FontSize="11"
                                       Foreground="#6C757D"
                                       HorizontalAlignment="Left" />

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,10">
                                <TextBlock Text="{Binding BalanceRightStableWeight, StringFormat='{}{0:0.###}'}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#212529" />
                                <TextBlock Text=" mg"
                                           FontSize="14"
                                           Foreground="#ADB5BD"
                                           VerticalAlignment="Bottom"
                                           Margin="4,0,0,4" />
                            </StackPanel>

                            <Button Grid.Row="2"
                                    Content="SET ZERO"
                                    Height="35"
                                    Background="#495057"
                                    Foreground="White"
                                    FontSize="12"
                                    Command="{Binding BalanceRightSetZeroCommand}">
                            </Button>
                        </Grid>
                    </Border>
                </UniformGrid>
            </GroupBox>
        </Grid>
    </GroupBox>
</UserControl>
