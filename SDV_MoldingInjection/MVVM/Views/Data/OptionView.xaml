<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.OptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             IsEnabled="{Binding MachineStatus.IsStandByProcessMode}"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type vm:OptionViewModel}}"
             xmlns:ui="clr-namespace:EQX.UI.Controls;assembly=EQX.UI"
             d:DesignHeight="600"
             d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Margin"
                    Value="0 5" />
            <Setter Property="Height"
                    Value="30" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="9*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Option Recipe"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#273c75"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <GroupBox x:Name="RootStackPanel"
                      Grid.RowSpan="2"
                      Header="Head Skip"
                      FontWeight="Bold"
                      Style="{x:Null}">
                <UniformGrid x:Name="OptionsRecipe_StackPanel"
                             Columns="1"
                             IsEnabled="{Binding MachineStatus.IsStandByProcessMode}" />
            </GroupBox>

            <GroupBox Header="IN/OUT Type"
                      FontWeight="Bold"
                      Style="{x:Null}"
                      Grid.Column="1">
                <StackPanel Orientation="Vertical">
                    <CheckBox Content="Auto"
                              Margin="5"
                              IsChecked="{Binding RecipeList.OptionRecipe.InputTypeAuto}"
                              Tag="Check to Input type Manual" />
                    <CheckBox Content="Manual"
                              Margin="5"
                              IsChecked="{Binding RecipeList.OptionRecipe.InputTypeManual}"
                              Tag="Check to Input type by Robot" />
                </StackPanel>
            </GroupBox>
            <GroupBox Header="CIM" 
                      Style="{x:Null}"  
                      Grid.Column="2">
                <UniformGrid Columns="2" 
                             VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="20"
                                     Height="20"
                                     Fill="{Binding IsNoError , Converter={StaticResource BooleanToOnOffBrushConverter}}" />
                            <Label Content="No Alarm"
                                   FontSize="14" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="20"
                                     Height="20"
                                     Fill="{Binding IsNoJig , Converter={StaticResource BooleanToOnOffBrushConverter}}" />
                            <Label Content="No Jig"
                                   FontSize="14" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="20"
                                     Height="20"
                                     Fill="{Binding IsCIMConnect , Converter={StaticResource BooleanToOnOffBrushConverter}}" />
                            <Label Content="CIM Connect"
                                   FontSize="14" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="20"
                                     Height="20"
                                     Fill="{Binding IsNoInterlock , Converter={StaticResource BooleanToOnOffBrushConverter}}" />
                            <Label Content="No Interlock"
                                   FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                    <CheckBox Content="Use CIM"
                              IsChecked="{Binding RecipeList.OptionRecipe.UseCIM}"
                              Tag="Check to Use CIM Report"
                              IsEnabled="{Binding IsEnableCIMModeChange}" 
                              Width="150"/>
                </UniformGrid>

            </GroupBox>

            <GroupBox Header="Inject"
                      FontWeight="Bold"
                      Style="{x:Null}"
                      Grid.Row="1"
                      Grid.Column="1">
                <StackPanel Orientation="Vertical">
                    <UniformGrid Columns="1" VerticalAlignment="Top">
                        <CheckBox Content="Skip Vent Time"
                                  Margin="5"
                                  IsChecked="{Binding RecipeList.OptionRecipe.SkipVentTime}"
                                  Tag="Check to skip vent time" />
                        <CheckBox Content="Delay After Inject Finish"
                                  Margin="5"
                                  IsChecked="{Binding RecipeList.OptionRecipe.DelayAfterInjectFinish}"
                                  Tag="Check to delay after inject finish" />
                        <!--<CheckBox Content="1 Torr And Purge"
                                  Margin="5"
                                  IsChecked="{Binding RecipeList.OptionRecipe.OneTorrAndPurge}"
                                  Tag="Check to start inject with 1 torr and purge" />-->
                        <!--<CheckBox Content="Inject First"
                                  Margin="5"
                                  IsChecked="{Binding RecipeList.OptionRecipe.InjectAfterOpenAngleValve}"
                                  Tag="Check to start inject after open angle valve" />-->
                        <CheckBox Content="Skip DryPump"
                                  Margin="5"
                                  IsChecked="{Binding RecipeList.OptionRecipe.SkipDryPumpPressure}"
                                  Tag="DryPump do not open valve when inject" />
                    </UniformGrid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Sequence"
                      FontWeight="Bold"
                      Style="{x:Null}"
                      Grid.Row="1"
                      Grid.Column="2">
                <StackPanel Orientation="Vertical">
                    <UniformGrid Columns="1">
                        <CheckBox Content="Skip Dispensing"
                                  Margin="5"
                                  IsChecked="{Binding RecipeList.OptionRecipe.SkipDispensing}"
                                  Tag="Check to skip dispensing" />
                        <CheckBox Content="Skip DummyShot"
                                  Margin="5"
                                  IsChecked="{Binding RecipeList.OptionRecipe.SkipDummyShot}"
                                  Tag="Check to skip dummy shot" />
                        <CheckBox Content="Skip Needle Clean"
                                  Margin="5"
                                  IsChecked="{Binding RecipeList.OptionRecipe.SkipNeedleClean}"
                                  Tag="Check to skip needle clean" />
                        <CheckBox Content="Dummy Before Inject"
                                  Margin="5"
                                  IsChecked="{Binding RecipeList.OptionRecipe.DummyBeforeInject}"
                                  Tag="Check to use DummyShot before inject" />
                        <!--<CheckBox Content="Save Pressure Log"
                                  Margin="5"
                                  IsChecked="{Binding RecipeList.OptionRecipe.SavePressureLog}"
                                  Tag="Check to Save Pressure Log" />-->
                    </UniformGrid>
                </StackPanel>
            </GroupBox>
        </Grid>

        <ui:ImageButton Content="{DynamicResource str_Save}"
                        Command="{Binding SaveCommand}"
                        Image="{StaticResource image_save_all_selected}"
                        FontSize="16"
                        Grid.Row="2"
                        Margin="5"
                        Height="50"
                        Width="200" />

    </Grid>
</UserControl>
