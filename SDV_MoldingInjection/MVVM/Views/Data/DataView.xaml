<UserControl
    x:Class="SDV_MoldingInjection.MVVM.Views.DataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
    xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
    xmlns:ui="clr-namespace:EQX.UI.Controls;assembly=EQX.UI"
    mc:Ignorable="d"
    x:Name="root"
    d:DataContext="{d:DesignInstance Type={x:Type vm:DataViewModel}}"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <UserControl.Resources>
        <Style
            TargetType="Button"
            BasedOn="{StaticResource {x:Type Button}}">
            <Setter
                Property="Height"
                Value="50" />
            <Setter
                Property="Margin"
                Value="10" />
            <Setter
                Property="FontSize"
                Value="16" />
        </Style>
    </UserControl.Resources>

    <UniformGrid
        Rows="1">
        <GroupBox
            Header="Recipe"
            Margin="5">
            <StackPanel
                Margin="0,10,0,0">
                <Button
                    Content="Recipe Setting"
                    Command="{Binding RecipeDataNavigateCommand}" />
                <Button
                    Content="Option Enable/Disable"
                    Command="{Binding OptionNavigateCommand}" />

                <Button
                    Content="Additional Molding"
                    Command="{Binding AdditionalMoldingDataNavigateCommand}" />
            </StackPanel>
        </GroupBox>

        <GroupBox
            Header="Other Setting"
            Margin="5">
            <StackPanel
                Margin="0,10,0,0">

                <Button
                    Content="{Binding RunModeButtonContent}"
                    Command="{Binding RunModeChangeCommand}" />

                <Button
                    Content="Material Ports"
                    Command="{Binding MaterialPortsViewNavigateCommand}" />
                <Button
                    Content="Security Control"
                    Command="{Binding SecurityControlNavigateCommand}" />
            </StackPanel>
        </GroupBox>

        <GroupBox
            Header="Time Setting"
            Margin="5">
            <StackPanel
                Margin="0,10,0,0">
                <Button
                    Content="Inject Time"
                    Command="{Binding InjectTimeNavigateCommand}" />
            </StackPanel>
        </GroupBox>

        <GroupBox
            Header="Servo Setting"
            Margin="5">
            <StackPanel
                Margin="0,10,0,0">
                <Button
                    Content="Motion Velocity"
                    Command="{Binding MotionConfigNavigateCommand}" />
            </StackPanel>
        </GroupBox>
    </UniformGrid>
</UserControl>