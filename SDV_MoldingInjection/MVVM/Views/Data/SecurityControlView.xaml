<UserControl
    x:Class="SDV_MoldingInjection.MVVM.Views.SecurityControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
    xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type={x:Type vm:SecurityControlViewModel}}"
    d:DesignHeight="500"
    d:DesignWidth="900">
    <Grid
        Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>

        <Label
            Content="Security Control"
            FontSize="24"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0 0 0 10" />

        <GroupBox
            Header="Data Window - Security Control"
            Grid.Row="1"
            Margin="0 0 0 10">
            <Grid
                Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="220" />
                    <ColumnDefinition
                        Width="300" />
                    <ColumnDefinition
                        Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Text="P/W MODE SELECT"
                    VerticalAlignment="Center" />
                <ComboBox
                    Grid.Column="1"
                    Height="32"
                    Margin="8 0"
                    ItemsSource="{Binding PasswordModes}"
                    SelectedItem="{Binding SelectedPasswordMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="1"
                    Text="SCREEN SAVER TIMER (sec)"
                    VerticalAlignment="Center"
                    Margin="0 8 0 0" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="32"
                    Margin="8 8 8 0"
                    Text="{Binding ScreenSaverSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Row="3"
                    Grid.Column="1"
                    Height="40"
                    Margin="8 12 8 0"
                    Content="Apply Security Setting"
                    Command="{Binding ApplySecuritySettingCommand}" />
            </Grid>
        </GroupBox>

        <GroupBox
            Header="Password Change"
            Grid.Row="2">
            <Grid
                Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="220" />
                    <ColumnDefinition
                        Width="300" />
                    <ColumnDefinition
                        Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Text="USER SELECT"
                    VerticalAlignment="Center" />
                <ComboBox
                    Grid.Column="1"
                    Height="32"
                    Margin="8 0"
                    ItemsSource="{Binding PermissionLevels}"
                    SelectedItem="{Binding SelectedPermissionLevel, Mode=TwoWay}" />

                <TextBlock
                    Grid.Row="1"
                    Text="CURRENT PASSWORD"
                    VerticalAlignment="Center"
                    Margin="0 8 0 0" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="32"
                    Margin="8 8 8 0"
                    PreviewMouseDown="keyBoardBox_PreviewMouseDown"
                    Text="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="2"
                    Text="NEW PASSWORD"
                    VerticalAlignment="Center"
                    Margin="0 8 0 0" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Height="32"
                    PreviewMouseDown="keyBoardBox_PreviewMouseDown"
                    Margin="8 8 8 0"
                    Text="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="3"
                    Text="CONFIRM PASSWORD"
                    VerticalAlignment="Center"
                    Margin="0 8 0 0" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Height="32"
                    Margin="8 8 8 0"
                    PreviewMouseDown="keyBoardBox_PreviewMouseDown"
                    Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.ColumnSpan="3"
                    Margin="0 10 0 0"
                    Foreground="Tomato"
                    Text="In RMS mode, Operator password change is disabled." />

                <Button
                    Grid.Row="5"
                    Grid.Column="1"
                    Height="40"
                    Margin="8 12 8 0"
                    VerticalAlignment="Top"
                    Content="Change Password"
                    Command="{Binding ChangePasswordCommand}" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
