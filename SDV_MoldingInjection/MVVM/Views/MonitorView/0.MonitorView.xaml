<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MonitorViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UniformGrid Rows="1">

        <GroupBox Header="I/O Status"
                  Margin="5 0">
            <StackPanel Orientation="Vertical">
                <Button Height="50" FontSize="14"
                    Content="Machine In/Out Check" Margin="3"
                    Command="{Binding MachineIONavigate}"/>

                <Button Height="50" FontSize="14"
                    Content="Head 1 In/Out Check" Margin="3"
                    Command="{Binding Head1IONavigate}"/>

                <Button Height="50" FontSize="14"
                    Content="Head 2 In/Out Check" Margin="3"
                    Command="{Binding Head2IONavigate}"/>
                <Button Height="50" FontSize="14"
                    Content="Head 3 In/Out Check" Margin="3"
                    Command="{Binding Head3IONavigate}"/>
                <Button Height="50" FontSize="14"
                    Content="Head 4 In/Out Check" Margin="3"
                    Command="{Binding Head4IONavigate}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Product Monitor"
                  Margin="5 0">

        </GroupBox>

        <GroupBox Header="Servo Status"
                  Margin="5 0">

        </GroupBox>
    </UniformGrid>
</UserControl>
