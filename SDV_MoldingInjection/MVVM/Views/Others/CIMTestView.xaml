<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.CIMTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             xmlns:ui="clr-namespace:EQX.UI.Controls;assembly=EQX.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CIMTestViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style
            TargetType="Button"
            BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </UserControl.Resources>

    <GroupBox Header="CIM TEST VIEW">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <WrapPanel>
                <Button
                    Content="SpecificValidationRequest1"
                    Command="{Binding SpecificValidationRequest1}"/>
                <Button
                    Content="SpecificValidationRequest2"
                    Command="{Binding SpecificValidationRequest2}"/>
                <Button
                    Content="TMPLostTest"
                    Command="{Binding TPMLostTest}"/>

                <Button
                    Content="ECMChangeTest"
                    Command="{Binding ECMChangeTest}"/>

                <Button
                    Content="CIM Function test"
                    Command="{Binding OpenCIMFunctionTestCommand}"/>

            </WrapPanel>

            <TextBox
                Text="{Binding Message, Mode=OneWay}"
                IsReadOnly="True"
                Grid.Column="1"/>

            <ui:LogDisplayer
                Grid.Row="1" Grid.ColumnSpan="2"/>
        </Grid>
    </GroupBox>
</UserControl>
