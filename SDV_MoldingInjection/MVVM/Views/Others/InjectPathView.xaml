<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.InjectPathView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             xmlns:models="clr-namespace:SDV_MoldingInjection.MVVM.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type models:InjectPath}}"
             d:DesignHeight="100"
             MinHeight="100"
             Margin="2 0"
             d:DesignWidth="100">
    <UniformGrid Columns="1"
                 Rows="2">
        <DockPanel Margin="0 0 0 3">
            <Label Content="Vel. Rate (%)"
                   Padding="0 -5"
                   FontWeight="Bold"
                   Foreground="{StaticResource HighLightBackgroundConstrastColor}"
                   Background="{StaticResource SecondaryBackgroundColor}"
                   HorizontalContentAlignment="Center"
                   DockPanel.Dock="Top" />
            <TextBox Text="{Binding VelocityRate, Mode=TwoWay}"
                     IsEnabled="True"
                     PreviewMouseUp="TextBox_MouseUp"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0 3 0 0">
            <Label Content="Duration (s)"
                   Padding="0 -5"
                   FontWeight="Bold"
                   Foreground="{StaticResource HighLightBackgroundConstrastColor}"
                   Background="{StaticResource SecondaryBackgroundColor}"
                   HorizontalContentAlignment="Center"
                   DockPanel.Dock="Top" />
            <TextBox Text="{Binding TimeInSecond, Mode=TwoWay}"
                     HorizontalContentAlignment="Center"
                     PreviewMouseUp="TextBox_MouseUp"
                     VerticalContentAlignment="Center"
                     IsEnabled="{Binding IsEnabled}"/>
        </DockPanel>
    </UniformGrid>
</UserControl>
