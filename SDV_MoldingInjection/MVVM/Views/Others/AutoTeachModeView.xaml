<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.AutoTeachModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="800">
    <Border BorderBrush="Gray"
            CornerRadius="5"
            BorderThickness="1"
            Margin="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Command="{Binding AutoModeSelectCommand}"
                    BorderBrush="{StaticResource PrimaryBorderBrush}"
                    Content="Auto">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource ActionButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutoMode}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="LightGreen" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Separator Width="35"
                       Height="1"
                       Grid.Column="1"
                       Margin="3 0">
                <Separator.LayoutTransform>
                    <RotateTransform Angle="90" />
                </Separator.LayoutTransform>
            </Separator>
            <Button Command="{Binding TeachModeSelectCommand}"
                    Content="Teach"
                    Grid.Column="2"
                    BorderBrush="{StaticResource PrimaryBorderBrush}">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource ActionButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTeachMode}"
                                         Value="true">
                                <Setter Property="Background"
                                        Value="Tomato" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
