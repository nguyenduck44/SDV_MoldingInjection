<Window x:Class="SDV_MoldingInjection.MVVM.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
        xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowState="Maximized"
        MaxWidth="1024"
        MaxHeight="768"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="/EQX.UI;component/Resources/Images/TopIcon.ico"
        AllowsTransparency="True"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        xmlns:uiControls="clr-namespace:EQX.UI.Controls;assembly=EQX.UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Title="MainWindowView">
    <Grid>
        <DockPanel
            Margin="7 7 0 0">
            <Grid
                Height="11"
                DockPanel.Dock="Bottom"
                Background="{StaticResource SecondaryBackgroundColor}" />
            <ContentControl
                Content="{Binding HeaderVM}"
                DockPanel.Dock="Top"
                Height="Auto" />
            <ContentControl
                Content="{Binding FooterVM}"
                DockPanel.Dock="Bottom" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="6*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentControl
                    Content="{Binding CurrentFrameVM}" />
                <ContentControl
                    Grid.Column="1"
                    Width="180"
                    Content="{Binding RightPanelVM}"
                    Visibility="{Binding ShowRightPanelVM, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DockPanel>

        <Border
            Background="#CC000000"
            Visibility="{Binding IsDoorSafetyOverlayVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <StackPanel
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="860">
                    <TextBlock
                        Text="{Binding DoorSafetyOverlayMessage}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontSize="52"
                        FontWeight="Bold"
                        Foreground="#FFFF5555"
                        Margin="0,0,0,24" />
                    <Button
                        Content="Enter Password"
                        Command="{Binding ConfirmDoorSafetyCommand}"
                        Height="58"
                        Width="420"
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    
    
</Window>
