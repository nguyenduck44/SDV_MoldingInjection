<Window x:Class="SDV_MoldingInjection.MVVM.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
        xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowState="Maximized"
        MaxWidth="1024" MaxHeight="768"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Icon="/EQX.UI;component/Resources/Images/TopIcon.ico"
        AllowsTransparency="True"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        xmlns:uiControls="clr-namespace:EQX.UI.Controls;assembly=EQX.UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Title="MainWindowView">

    <DockPanel Margin="7 0 0 0">
        <Grid Height="11.5"
                DockPanel.Dock="Bottom"
                Background="{StaticResource PrimaryBackgroundColor}" />
        <ContentControl Content="{Binding HeaderVM}"
                        DockPanel.Dock="Top"
                        Height="Auto" />
        <ContentControl Content="{Binding FooterVM}"
                        DockPanel.Dock="Bottom" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <ContentControl Content="{Binding CurrentFrameVM}" />
            <ContentControl Grid.Column="1" Width="180"
                Content="{Binding RightPanelVM}"
                Visibility="{Binding ShowRightPanelVM, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </DockPanel>
</Window>
