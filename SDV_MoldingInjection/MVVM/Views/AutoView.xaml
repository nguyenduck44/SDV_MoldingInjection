<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.AutoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             xmlns:controls="clr-namespace:SDV_MoldingInjection.Controls"
             mc:Ignorable="d"
             x:Name="root"
             d:DataContext="{d:DesignInstance Type={x:Type vm:AutoViewModel}}"
             d:DesignHeight="1060"
             d:DesignWidth="1920">

    <UserControl.Resources>
        <Style x:Key="DoorIndicatorRectangleStyle"
               TargetType="Rectangle">
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalAlignment"
                    Value="Stretch" />
            <Setter Property="RadiusX"
                    Value="2" />
            <Setter Property="RadiusY"
                    Value="2" />
            <Setter Property="Stroke"
                    Value="Black" />
            <Setter Property="StrokeThickness"
                    Value="1" />
            <Setter Property="Margin"
                    Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="2 0 0 0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.1*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <!-- SYRINGE AMOUNT -->
        <GroupBox Grid.Column="0"
                  Header="Syringe Amount (g)"
                  Margin="5"
                  Style="{x:Null}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="5 5 5 0">
                    <TextBlock Text="H1"
                               Width="60"
                               TextAlignment="Center"
                               FontWeight="Bold" />
                    <TextBlock Text="H2"
                               Width="60"
                               TextAlignment="Center"
                               FontWeight="Bold" />
                    <TextBlock Text="H3"
                               Width="60"
                               TextAlignment="Center"
                               FontWeight="Bold" />
                    <TextBlock Text="H4"
                               Width="60"
                               TextAlignment="Center"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding SyringeAmountStatusList.SyringeAmounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Width="60" 
                                                Content="{Binding .}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </GroupBox>

        <!-- Machine Image -->
        <Image Grid.Column="1"
               Grid.RowSpan="2"
               Margin="0 0 15 0"
               Source="/SDV_MoldingInjection;component/Resource/Images/MoldInjection_TopView.png" />

        <!-- DoorLock View -->
        <Grid Grid.Row="0"
              Grid.Column="1">
            <Canvas>
                <Rectangle Width="10"
                           Height="199"
                           Canvas.Left="208"
                           Canvas.Top="149"
                           Style="{StaticResource DoorIndicatorRectangleStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top">
                    <Rectangle.Fill>
                        <MultiBinding Converter="{StaticResource DoorStatusToBrushConverterRevers}">
                            <Binding Path="Devices.Inputs.DoorOpenLeft.Value" />
                            <Binding Path="Devices.Inputs.DoorReleaseLeft.Value" />
                        </MultiBinding>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Width="10"
                           Height="130"
                           Canvas.Left="529"
                           Canvas.Top="230"
                           Style="{StaticResource DoorIndicatorRectangleStyle}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center">
                    <Rectangle.Fill>
                        <MultiBinding Converter="{StaticResource DoorStatusToBrushConverterRevers}">
                            <Binding Path="Devices.Inputs.DoorOpenRight.Value" />
                            <Binding Path="Devices.Inputs.DoorReleaseRight.Value" />
                        </MultiBinding>
                    </Rectangle.Fill>
                </Rectangle>

                <Rectangle Width="10"
                           Height="82"
                           Canvas.Left="529"
                           Canvas.Top="149"
                           Fill="Gray"
                           Style="{StaticResource DoorIndicatorRectangleStyle}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
