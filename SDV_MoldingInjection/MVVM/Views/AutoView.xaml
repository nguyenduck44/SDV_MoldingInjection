<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.AutoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             xmlns:ui="clr-namespace:EQX.UI.Controls;assembly=EQX.UI"
             xmlns:uiMVVM="clr-namespace:EQX.UI.MVVM;assembly=EQX.UI"
             xmlns:controls="clr-namespace:SDV_MoldingInjection.Controls"
             mc:Ignorable="d"
             x:Name="root"
             d:DataContext="{d:DesignInstance Type={x:Type vm:AutoViewModel}}"
             d:DesignHeight="610"
             d:DesignWidth="845">

    <UserControl.Resources>
        <Style x:Key="DoorIndicatorRectangleStyle"
               TargetType="Rectangle">
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalAlignment"
                    Value="Stretch" />
            <Setter Property="RadiusX"
                    Value="2" />
            <Setter Property="RadiusY"
                    Value="2" />
            <Setter Property="Stroke"
                    Value="Black" />
            <Setter Property="StrokeThickness"
                    Value="1" />
            <Setter Property="Margin"
                    Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="2 0 0 0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid>
            <StackPanel>
                <GroupBox Header="Carrier Jig Status"
                          Style="{x:Null}">
                    <UniformGrid Margin="0 6 0 0"
                                 Rows="1">
                        <ContentControl Content="{Binding CarrierJigStatusList.CarrierJigStatusH1}" />
                        <ContentControl Content="{Binding CarrierJigStatusList.CarrierJigStatusH2}" />
                        <ContentControl Content="{Binding CarrierJigStatusList.CarrierJigStatusH3}" />
                        <ContentControl Content="{Binding CarrierJigStatusList.CarrierJigStatusH4}" />
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="Chamber Pressure Chart"
                          Style="{x:Null}">
                    <ContentControl Content="{Binding Plotter.ChamberPressurePlot, Mode=OneWay}"
                                    Height="250" />
                </GroupBox>
            </StackPanel>

            <Grid Grid.Row="1"
                  Grid.Column="0"
                  Margin="5"
                  VerticalAlignment="Bottom">
                <UniformGrid Rows="1"
                             Columns="3"
                             HorizontalAlignment="Center">
                    <ui:ImageButton Image="/EQX.UI;component/Resources/Images/Components/Common/lock_selected.png"
                                    DisabledImage="/EQX.UI;component/Resources/Images/Components/Common/lock_selected.png"
                                    Command="{Binding DoorOpenCommand}"
                                    IsEnabled="{Binding MachineStatus.IsStandByProcessMode}"
                                    Width="85"
                                    Height="42"
                                    Margin="2">
                        <ui:ImageButton.Style>
                            <Style TargetType="{x:Type ui:ImageButton}"
                                   BasedOn="{StaticResource {x:Type ui:ImageButton}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.Outputs.EQPStop.Value}"
                                                 Value="True">
                                        <Setter Property="Content"
                                                Value="Door Lock" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Devices.Outputs.EQPStop.Value}"
                                                 Value="False">
                                        <Setter Property="Content"
                                                Value="Door Unlock" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:ImageButton.Style>
                    </ui:ImageButton>
                </UniformGrid>
            </Grid>
        </Grid>


        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="165"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- SYRINGE AMOUNT -->
            <Grid IsEnabled="{Binding MachineStatus.IsStandByProcessMode}"
                  Width="245"
                  HorizontalAlignment="Left">
                <StackPanel>
                    <GroupBox Header="Syringe Amount (g)"
                              FontSize="14"
                              Style="{x:Null}">
                        <GroupBox.LayoutTransform>
                            <ScaleTransform ScaleX="0.8"
                                            ScaleY="0.8" />
                        </GroupBox.LayoutTransform>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="5 5 5 0">
                                <TextBlock Text="H1"
                                           Width="60"
                                           TextAlignment="Center"
                                           FontWeight="Bold" />
                                <TextBlock Text="H2"
                                           Width="60"
                                           TextAlignment="Center"
                                           FontWeight="Bold" />
                                <TextBlock Text="H3"
                                           Width="60"
                                           TextAlignment="Center"
                                           FontWeight="Bold" />
                                <TextBlock Text="H4"
                                           Width="60"
                                           TextAlignment="Center"
                                           FontWeight="Bold" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding SyringeAmountStatusList.SyringeAmounts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="70"
                                                    CornerRadius="4"
                                                    Padding="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="Transparent" />
                                                        <Setter Property="Opacity"
                                                                Value="0.8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHeadAvailable}"
                                                                         Value="False">
                                                                <Setter Property="Background"
                                                                        Value="Transparent" />
                                                                <Setter Property="Opacity"
                                                                        Value="0.8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ContentControl Content="{Binding .}"
                                                                IsEnabled="{Binding IsHeadAvailable}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>

            <!-- PRODUCTION -->
            <GroupBox Header="PRODUCTION"
                      Style="{x:Null}"
                      Width="148"
                      Height="100"
                      VerticalAlignment="Top"
                      HorizontalAlignment="Left"
                      Grid.Column="1">
                <Grid Margin="8 6">
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize"
                                    Value="14" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                        </Style>
                        <Style TargetType="TextBox">
                            <Setter Property="FontSize"
                                    Value="14" />
                            <Setter Property="FontWeight"
                                    Value="SemiBold" />
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Padding="6 2">
                        <TextBlock VerticalAlignment="Center"
                                   Text="Input" />
                    </Border>
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Padding="2">
                        <TextBox IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Right"
                                 Text="{Binding TodayInputCount,Mode=OneWay}" />
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Padding="6 2">
                        <TextBlock VerticalAlignment="Center"
                                   Text="Output" />
                    </Border>
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Padding="2">
                        <TextBox IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Right"
                                 Text="{Binding TodayOutputCount,Mode=OneWay}" />
                    </Border>
                </Grid>
            </GroupBox>

            <!-- PC INFORMATION -->
            <StackPanel Grid.Column="2"
                        Margin="0"
                        VerticalAlignment="Top">
                <uiMVVM:PCInformationsystemView DataContext="{Binding PCInformationsystemViewModel}" />
            </StackPanel>
            <!-- MACHINE -->
            <DockPanel Grid.Row="2"
                       Grid.ColumnSpan="3"
                       Margin="0 8 0 0">
                <local:MachineStatusAutoView DataContext="{Binding MachineStatusAuto}" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
