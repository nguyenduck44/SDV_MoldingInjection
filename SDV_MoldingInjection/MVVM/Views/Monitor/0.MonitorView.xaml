<UserControl
    x:Class="SDV_MoldingInjection.MVVM.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
    xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MonitorViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <UserControl.Resources>
        <Style
            TargetType="Button"
            BasedOn="{StaticResource {x:Type Button}}">
            <Setter
                Property="Height"
                Value="50" />
            <Setter
                Property="Margin"
                Value="10" />
            <Setter
                Property="FontSize"
                Value="16" />
        </Style>
    </UserControl.Resources>
    <UniformGrid
        Rows="1">
        <GroupBox
            Header="I/O Status"
            Margin="5 0">
            <StackPanel
                Orientation="Vertical">
                
                <Button
                    Content="Machine In/Out Check"
                    Command="{Binding MachineIONavigate}" />
                <Button
                    Content="Head 1 In/Out Check"
                    Command="{Binding Head1IONavigate}" />
                <Button
                    Content="Head 2 In/Out Check"
                    Command="{Binding Head2IONavigate}" />
                <Button
                    Content="Head 3 In/Out Check"
                    Command="{Binding Head3IONavigate}" />
                <Button
                    Content="Head 4 In/Out Check"
                    Command="{Binding Head4IONavigate}" />
            </StackPanel>
        </GroupBox>

        <GroupBox
            Header="Product Monitor"
            Margin="5 0">
            <StackPanel
                Orientation="Vertical">
                <Button
                    Content="Production Infor"
                    Command="{Binding ProductionInforNavigateCommand}" />
                <Button
                    Content="Tact Time"
                    Command="{Binding TactTimeNavigateCommand}" />
                <Button
                    Content="Terminal Display"
                    Command="{Binding TerminalMessageNavigateCommand}" />
                <Button
                    Content="Operator Call Msg"
                    Command="{Binding OPCallMsgNavigateCommand}" />
                <Button
                    Content="Interlock Msg"
                    Command="{Binding InterlockMsgNavigateCommand}" />
            </StackPanel>
        </GroupBox>

        <GroupBox
            Header="Servo Status"
            Margin="5 0">

        </GroupBox>
    </UniformGrid>
</UserControl>
