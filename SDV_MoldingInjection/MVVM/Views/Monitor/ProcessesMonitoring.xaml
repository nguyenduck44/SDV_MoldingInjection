<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.ProcessesMonitoring"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type vm:ProcessesMonitoringViewModel}}"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <StackPanel>
        <TextBlock Text="Process Status"
                   FontSize="22"
                   HorizontalAlignment="Center"
                   FontWeight="SemiBold"
                   Margin="0 5 0 10"
                   Foreground="#273c75" />
        <DataGrid x:Name="ErrorListHistoryDataGrid"
                  Margin="5"
                  Grid.Row="1"
                  FontSize="18"
                  HorizontalContentAlignment="Center"
                  AutoGenerateColumns="False"
                  AlternatingRowBackground="LightSkyBlue"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionUnit="CellOrRowHeader"
                  SelectionMode="Extended"
                  ClipboardCopyMode="ExcludeHeader"
                  CanUserAddRows="False"
                  ItemsSource="{Binding Processes.All}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    IsReadOnly="True"
                                    Binding="{Binding Name}"
                                    Width="*" />
                <DataGridTextColumn Header="Mode"
                                    IsReadOnly="True"
                                    Binding="{Binding ProcessMode}"
                                    Width="*" />
                <DataGridTextColumn Header="Sequence"
                                    IsReadOnly="True"
                                    Binding="{Binding Sequence}"
                                    Width="*" />
                <DataGridTextColumn Header="Run Step"
                                    IsReadOnly="True"
                                    Width="*">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource RunStepDisplayConverter}">
                            <Binding Path="Name" />
                            <Binding Path="Sequence" />
                            <Binding Path="Step.RunStep" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
