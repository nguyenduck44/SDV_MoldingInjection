<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.InterfaceInOutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type vm:InterfaceInOutViewModel}}"
             d:DesignHeight="550" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Function"
                  Margin="5"
                  Style="{StaticResource TextBlockHeaderGroupBox}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="Send Transmit"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <UniformGrid Columns="2"
                                 Margin="0,0,0,12">
                        <Button Content="CTRD - Ready Send"
                                Margin="4"
                                Command="{Binding SendTransmitCommand}"
                                CommandParameter="CTRD" />
                        <Button Content="CTRN - Check Run Send"
                                Margin="4"
                                Command="{Binding SendTransmitCommand}"
                                CommandParameter="CTRN" />
                        <Button Content="CTCH - Product Check Send"
                                Margin="4"
                                Command="{Binding SendTransmitCommand}"
                                CommandParameter="CTCH" />
                        <Button Content="CTPT - Position Check Send"
                                Margin="4"
                                Command="{Binding SendTransmitCommand}"
                                CommandParameter="CTPT" />
                        <Button Content="CTST - Start"
                                Margin="4"
                                Command="{Binding SendTransmitCommand}"
                                CommandParameter="CTST" />
                        <Button Content="CTSP - Stop"
                                Margin="4"
                                Command="{Binding SendTransmitCommand}"
                                CommandParameter="CTSP" />
                        <Button Content="CTSI - Set Idle Purge"
                                Margin="4"
                                Command="{Binding SendTransmitCommand}"
                                CommandParameter="CTSI" />
                        <Button Content="CTCI - Clear Idle Purge"
                                Margin="4"
                                Command="{Binding SendTransmitCommand}"
                                CommandParameter="CTCI" />
                        <Button Content="CTEN - Send End"
                                Margin="4"
                                Command="{Binding SendEndCommand}" />
                    </UniformGrid>

                    <Separator Margin="0,0,0,10" />

                    <TextBlock Text="CTUS + CTUE - Head Use"
                               FontWeight="SemiBold" />
                    <Grid Margin="0,6,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0"
                                  Grid.ColumnSpan="2"
                                  Margin="0,0,0,8"
                                  IsChecked="{Binding UseHead12, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Content="Head 1-2 (checked = use)" />
                        <CheckBox Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,0,0,8"
                                  IsChecked="{Binding UseHead34, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Content="Head 3-4 (checked = use)" />

                        <Button Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Content="Send CTUS + CTUE"
                                Command="{Binding SendHeadUseCommand}" />
                    </Grid>

                    <Separator Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Margin="0,0,8,0"
                                 PreviewMouseUp="TextBox_MouseUp"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ErrorCodeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Content="CTER - Send Error"
                                Command="{Binding SendErrorCommand}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Header="Message"
                  Grid.Column="1"
                  Margin="5"
                  Style="{StaticResource TextBlockHeaderGroupBox}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Message"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right"
                            Content="Clear"
                            Width="80"
                            Command="{Binding ClearLogCommand}" />
                </DockPanel>

                <GroupBox Grid.Row="1"
                          Header="Send"
                          Margin="0,0,0,6">
                    <ListBox FontFamily="Consolas"
                             FontSize="12"
                             ItemsSource="{Binding SendMessages}" />
                </GroupBox>

                <GroupBox Grid.Row="2"
                          Header="Receive">
                    <ListBox FontFamily="Consolas"
                             FontSize="12"
                             ItemsSource="{Binding ReceiveMessages}" />
                </GroupBox>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
