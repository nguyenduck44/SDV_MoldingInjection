<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.AnalogStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type vm:AnalogStatusViewModel}}"
             xmlns:controls="clr-namespace:SDV_MoldingInjection.Controls"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="FlatActionButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#f2f2f2" />
            <Setter Property="BorderBrush"
                    Value="#bfbfbf" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Foreground"
                    Value="#202020" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Height"
                    Value="30" />
            <Setter Property="Padding"
                    Value="14,2" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <DockPanel Grid.Row="0"
                   LastChildFill="False">
            <TextBlock Text="CDA VALUE"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#273c75"
                       HorizontalAlignment="Center"
                       DockPanel.Dock="Top" />
            <Label Content="Main Air"
                   FontSize="10"
                   Width="100"
                   Height="50"
                   BorderBrush="Black"
                   BorderThickness="1"
                   Background="WhiteSmoke"
                   Grid.Column="1"
                   HorizontalAlignment="Center"
                   VerticalContentAlignment="Center"
                   FontWeight="Bold" />
            <Label Content="{Binding CDA }"
                   FontSize="10"
                   Width="200"
                   Height="50"
                   BorderBrush="Black"
                   BorderThickness="1"
                   Background="WhiteSmoke"
                   Grid.Column="1"
                   HorizontalAlignment="Center"
                   VerticalContentAlignment="Center"
                   FontWeight="Bold" />
            
        </DockPanel>
    </Grid>
</UserControl>
