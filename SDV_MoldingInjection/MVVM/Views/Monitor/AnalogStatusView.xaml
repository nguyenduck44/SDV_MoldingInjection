<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.AnalogStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type vm:AnalogStatusViewModel}}"
             xmlns:controls="clr-namespace:SDV_MoldingInjection.Controls"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <DockPanel Grid.Row="0"
                   LastChildFill="False">
            <TextBlock Text="CDA VALUE"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#273c75"
                       HorizontalAlignment="Center"
                       DockPanel.Dock="Top" />
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Main Air"
                           FontSize="10"
                           Width="150"
                           Height="50"
                           BorderBrush="Black"
                           BorderThickness="1"
                           Background="WhiteSmoke"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontWeight="Bold" />
                    <TextBlock Text="{Binding CDAStatus.MainAirCDA,StringFormat={}{0:F3} MPa }"
                               FontSize="10"
                               Width="200"
                               Height="50"
                               Background="WhiteSmoke"
                               Grid.Column="1"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Clean Pressure CDA"
                           FontSize="10"
                           Width="150"
                           Height="50"
                           BorderBrush="Black"
                           BorderThickness="1"
                           Background="WhiteSmoke"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalContentAlignment="Center"
                           FontWeight="Bold" />
                    <TextBlock Text="{Binding CDAStatus.CleanPressureCDA,StringFormat={}{0:F3} MPa }"
                               FontSize="10"
                               Width="200"
                               Height="50"
                               HorizontalAlignment="Center"
                               Background="WhiteSmoke"
                               Grid.Column="1"
                               FontWeight="Bold" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
