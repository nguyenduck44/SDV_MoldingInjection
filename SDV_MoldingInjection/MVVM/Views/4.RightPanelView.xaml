<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.RightPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             mc:Ignorable="d" 
             xmlns:defines="clr-namespace:SDV_MoldingInjection.Defines"
             xmlns:cvt="clr-namespace:SDV_MoldingInjection.Converters"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             xmlns:ui="clr-namespace:EQX.UI.Controls;assembly=EQX.UI"
             d:DataContext="{d:DesignInstance Type={x:Type vm:RightPanelViewModel}}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="Border">
            <Setter Property="BorderThickness"
                    Value="2" />
            <Setter Property="BorderBrush"
                    Value="LightGray" />
            <Setter Property="CornerRadius"
                    Value="5" />
            <Setter Property="Cursor"
                    Value="Hand" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="FontSize"
                    Value="12" />
        </Style>
        <Style
            TargetType="{x:Type ui:ImageButton}"
            BasedOn="{StaticResource {x:Type ui:ImageButton}}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="MaxHeight" Value="50" />
        </Style>
        <Style
            TargetType="{x:Type ui:ImageRadioButton}"
            BasedOn="{StaticResource {x:Type ui:ImageRadioButton}}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="MaxHeight" Value="50" />
        </Style>
        <Style
            TargetType="{x:Type GroupBox}"
            BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding}" 
                            Foreground="Wheat"
                            FontSize="14"
                            TextAlignment="Center"
                            FontWeight="Bold"
                            Background="{StaticResource SecondaryBackgroundColor}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Top">
            <GroupBox
                Header="{DynamicResource str_Machine_Status}"
                Margin="0 0 0 3">
                <Label Content="{Binding MachineStatus.CurrentProcessMode}"
                       FontSize="14" Padding="0 5"
                       FontWeight="Bold"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       Typography.Capitals="AllPetiteCaps"
                       Background="AliceBlue" />
            </GroupBox>
            <GroupBox
                Header="Run Mode"
                Margin="0 0 0 3">
                <Label Content="{Binding MachineStatus.MachineRunMode}"
                       FontSize="14" Padding="0 5"
                       FontWeight="Bold"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       Typography.Capitals="AllPetiteCaps"
                       Background="AliceBlue" />
            </GroupBox>
            <GroupBox
                Header="Pressure"
                Margin="0 0 0 3">
                <TextBlock
                    FontSize="16" FontWeight="Bold"
                    Foreground="Coral"
                    TextAlignment="Center"
                    d:Text="1.234 Torr"
                    Text="{Binding Pressure, StringFormat={}{0:F3} Torr, Mode=OneWay}"/>

            </GroupBox>
            <GroupBox Header="Chamber" FontSize="16">
                <UniformGrid Rows="1">
                    <Button
                            Content="Chamber Open"
                            Height="50" Margin="2"
                            Command="{Binding ChamberOpenCommand}"/>
                    <Button
                            Content="Chamber Close"
                            Height="50" Margin="2"
                            Command="{Binding ChamberCloseCommand}"/>
                </UniformGrid>
            </GroupBox>
        </StackPanel>

        <UniformGrid
                Columns="1" Grid.Row="1"
                VerticalAlignment="Bottom">
            <ui:ImageRadioButton
                        Image="/EQX.UI;component/Resources/Images/Components/Common/auto_selected.png"
                        DisabledImage="/EQX.UI;component/Resources/Images/Components/Common/auto_normal_light.png"
                        Content="{DynamicResource str_AutoMode}"/>

            <ui:ImageRadioButton
                        Image="/EQX.UI;component/Resources/Images/Components/Common/manual_selected.png"
                        DisabledImage="/EQX.UI;component/Resources/Images/Components/Common/manual_normal_light.png"
                        Content="{DynamicResource str_ManualMode}" IsChecked="True"/>


            <ui:ImageButton
                    Image="/EQX.UI;component/Resources/Images/Components/Common/model_change_Selected.png"
                    Content="{DynamicResource str_AutoRun}"
                    Command="{Binding StartCommand}"
                    IsEnabled="{Binding MachineStatus.IsStandByProcessMode}" />

            <ui:ImageButton
                    Image="/EQX.UI;component/Resources/Images/Components/Common/stop_selected.png"
                    Content="{DynamicResource str_CycleStop}"
                    Command="{Binding StopCommand}" />

            <ui:ImageButton
                    Image="/EQX.UI;component/Resources/Images/Components/Common/pause_selected.png"
                    Content="{DynamicResource str_Pause}"
                    Command="{Binding StopCommand}" />

            <ui:ImageButton
                    Image="/EQX.UI;component/Resources/Images/Components/Common/return_origin_selected.png"
                    Content="{DynamicResource str_Origin}"
                    Command="{Binding OriginCommand}" />

        </UniformGrid>
    </Grid>
</UserControl>
