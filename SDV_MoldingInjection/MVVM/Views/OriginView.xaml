<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.OriginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             mc:Ignorable="d"
             x:Name="root"
             Loaded="root_Loaded"
             xmlns:corePro="clr-namespace:EQX.Core.Process;assembly=EQX.Core"
             xmlns:ui="clr-namespace:EQX.UI.Controls;assembly=EQX.UI"
             xmlns:process="clr-namespace:EQX.Process;assembly=EQX.Process"
             xmlns:localPro="clr-namespace:SDV_MoldingInjection.Process"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type vm:OriginViewModel}}"
             d:DesignHeight="610"
             d:DesignWidth="1000">
    <UserControl.Resources>
            <Style x:Key="DoorIndicatorRectangleStyle"
               TargetType="Rectangle">
                <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
                <Setter Property="VerticalAlignment"
                    Value="Stretch" />
                <Setter Property="RadiusX"
                    Value="2" />
                <Setter Property="RadiusY"
                    Value="2" />
                <Setter Property="Stroke"
                    Value="Black" />
                <Setter Property="StrokeThickness"
                    Value="1" />
                <Setter Property="Margin"
                    Value="0" />
            </Style>
        <DataTemplate DataType="{x:Type localPro:MIProcess}">
            <Border BorderBrush="Gray"
                    Width="120"
                    IsEnabled="{Binding DataContext.MachineStatus.IsStandByProcessMode,ElementName=root}"
                    Cursor="Hand"
                    BorderThickness="1"
                    PreviewMouseDown="Border_PreviewMouseDown">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Label Content="{Binding Name}"
                           FontWeight="Bold"
                           FontSize="12"
                           HorizontalContentAlignment="Center"
                           Foreground="White">
                        <Label.Style>
                            <Style TargetType="{x:Type Label}"
                                   BasedOn="{StaticResource {x:Type Label}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOriginOrInitSelected}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="#2196F3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOriginOrInitSelected}"
                                                 Value="False">
                                        <Setter Property="Background"
                                                Value="Black" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>
                    <Label Grid.Row="1"
                           FontWeight="SemiBold"
                           HorizontalContentAlignment="Center">
                        <Label.Style>
                            <Style TargetType="{x:Type Label}"
                                   BasedOn="{StaticResource {x:Type Label}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlarm}"
                                                 Value="True">
                                        <Setter Property="Content"
                                                Value="Alarm,Need Origin" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAlarm}"
                                                 Value="False">
                                        <Setter Property="Content"
                                                Value="Origin Done" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAlarm}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="OrangeRed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAlarm}"
                                                 Value="False">
                                        <Setter Property="Background"
                                                Value="GreenYellow" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>
                </Grid>
            </Border>
        </DataTemplate>
        <Style
            TargetType="{x:Type ui:ImageButton}"
            BasedOn="{StaticResource {x:Type ui:ImageButton}}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="MaxHeight" Value="50" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="0 0 -5 0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <Canvas>
            <Border Canvas.Top="80"
                Background="White"
                Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="XY AXIS"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding XYMotions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:MotionStatusTileView Margin="0,0,0,10">
                                        <ui:MotionStatusTileView.LayoutTransform>
                                            <ScaleTransform ScaleX="0.4"
                                                        ScaleY="0.5" />
                                        </ui:MotionStatusTileView.LayoutTransform>
                                    </ui:MotionStatusTileView>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="HEAD AXIS"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,8,0,6" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Head 1"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Head1Motions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:MotionStatusTileView Margin="0,0,0,6">
                                                <ui:MotionStatusTileView.LayoutTransform>
                                                    <ScaleTransform ScaleX="0.4"
                                                                ScaleY="0.5" />
                                                </ui:MotionStatusTileView.LayoutTransform>
                                            </ui:MotionStatusTileView>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Head 2"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Head2Motions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:MotionStatusTileView Margin="0,0,0,6">
                                                <ui:MotionStatusTileView.LayoutTransform>
                                                    <ScaleTransform ScaleX="0.4"
                                                                ScaleY="0.5" />
                                                </ui:MotionStatusTileView.LayoutTransform>
                                            </ui:MotionStatusTileView>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Head 3"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Head3Motions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:MotionStatusTileView Margin="0,0,0,6">
                                                <ui:MotionStatusTileView.LayoutTransform>
                                                    <ScaleTransform ScaleX="0.4"
                                                                ScaleY="0.5" />
                                                </ui:MotionStatusTileView.LayoutTransform>
                                            </ui:MotionStatusTileView>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Head 4"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Head4Motions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:MotionStatusTileView Margin="0,0,0,6">
                                                <ui:MotionStatusTileView.LayoutTransform>
                                                    <ScaleTransform ScaleX="0.4"
                                                                ScaleY="0.5" />
                                                </ui:MotionStatusTileView.LayoutTransform>
                                            </ui:MotionStatusTileView>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Canvas>
        <Image Grid.Column="1"
               Grid.RowSpan="2"
               Margin="0 30 5 0"
               Source="/SDV_MoldingInjection;component/Resource/Images/MachineView.png" />
        <!-- DoorLock View -->
        <Grid Grid.Row="0"
              Grid.Column="1"
              Grid.RowSpan="6">
            <Canvas>
                <Grid Width="15"
                      Height="190"
                      Canvas.Left="225"
                      Canvas.Top="196">
                    <Rectangle Style="{StaticResource DoorIndicatorRectangleStyle}">
                        <Rectangle.Fill>
                            <MultiBinding Converter="{StaticResource DoorStatusToBrushConverterRevers}">
                                <Binding Path="Devices.Inputs.DoorOpenLeft.Value" />
                                <Binding Path="Devices.Inputs.DoorReleaseLeft.Value" />
                            </MultiBinding>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="DOOR LEFT CLOSE"
                               Foreground="Black"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Grid>
            </Canvas>
            <Canvas>
                <Grid Width="15"
                      Height="190"
                      Canvas.Right="7"
                      Canvas.Top="196">
                    <Rectangle Style="{StaticResource DoorIndicatorRectangleStyle}">
                        <Rectangle.Fill>
                            <MultiBinding Converter="{StaticResource DoorStatusToBrushConverterRevers}">
                                <Binding Path="Devices.Inputs.DoorOpenRight.Value" />
                                <Binding Path="Devices.Inputs.DoorReleaseRight.Value" />
                            </MultiBinding>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="DOOR RIGHT CLOSE"
                               Foreground="Black"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Grid>
            </Canvas>
            <Canvas>
                <Grid Width="150"
                      Height="17"
                      Canvas.Left="240"
                      Canvas.Top="196">
                    <Rectangle Style="{StaticResource DoorIndicatorRectangleStyle}">
                        <Rectangle.Fill>
                            <MultiBinding Converter="{StaticResource DoorStatusToBrushConverterRevers}">
                                <Binding Path="Devices.Inputs.DoorOpenRearLeft.Value" />
                                <Binding Path="Devices.Inputs.DoorReleaseRearLeft.Value" />
                            </MultiBinding>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="DOOR REAR LEFT CLOSE"
                               Width="146"
                               Foreground="Black"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               TextAlignment="Center"
                               FontSize="11">
                    </TextBlock>
                </Grid>
            </Canvas>

            <Canvas>
                <Grid Width="155"
                      Height="16"
                      Canvas.Right="20"
                      Canvas.Top="196">
                    <Rectangle Style="{StaticResource DoorIndicatorRectangleStyle}">
                        <Rectangle.Fill>
                            <MultiBinding Converter="{StaticResource DoorStatusToBrushConverterRevers}">
                                <Binding Path="Devices.Inputs.DoorOpenRearRight.Value" />
                                <Binding Path="Devices.Inputs.DoorReleaseRearRight.Value" />
                            </MultiBinding>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="DOOR REAR RIGHT CLOSE"
                               Width="147"
                               Foreground="Black"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               TextAlignment="Center"
                               FontSize="11">
                    </TextBlock>
                </Grid>
            </Canvas>

            <Canvas>
                <Grid Width="150"
                      Height="15"
                      Canvas.Left="240"
                      Canvas.Top="370">
                    <Rectangle Style="{StaticResource DoorIndicatorRectangleStyle}">
                        <Rectangle.Fill>
                            <Binding Path="Devices.Inputs.PanelCloseLeftCheck.Value"
                                     Converter="{StaticResource BooleanToOnOffBrushConverter}" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="MAIN PANEL LEFT CLOSE"
                               Foreground="Black"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center">
                    </TextBlock>
                </Grid>
            </Canvas>
            <Canvas>
                <Grid Width="150"
                      Height="15"
                      Canvas.Right="20"
                      Canvas.Top="370">
                    <Rectangle Style="{StaticResource DoorIndicatorRectangleStyle}">
                        <Rectangle.Fill>
                            <Binding Path="Devices.Inputs.PanelCloseRightCheck.Value"
                                     Converter="{StaticResource BooleanToOnOffBrushConverter}" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="MAIN PANEL RIGHT CLOSE"
                               Foreground="Black"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center">
                    </TextBlock>
                </Grid>
            </Canvas>
            <Canvas />
        </Grid>
        <Canvas Grid.Column="1">
            <Canvas.LayoutTransform>
                <!-- Scale down process status tiles -->
                <ScaleTransform ScaleX="0.6"
                                ScaleY="0.6" />
            </Canvas.LayoutTransform>
            <!--<ContentControl Content="{Binding Processes.All[1]}"
                    Canvas.Left="70"
                    Canvas.Top="100"/>-->
            <ContentControl Content="{Binding Processes.All[2]}"
                    Canvas.Left="71"
                    Canvas.Bottom="250"/>
            <ContentControl Content="{Binding Processes.All[3]}"
                    Canvas.Left="440"
                    Canvas.Top="450"/>
            <ContentControl Content="{Binding Processes.All[4]}"
                    Canvas.Left="540"
                    Canvas.Top="400"/>
            <ContentControl Content="{Binding Processes.All[5]}"
                    Canvas.Left="635"
                    Canvas.Top="450"/>
            <ContentControl Content="{Binding Processes.All[6]}"
                    Canvas.Left="735"
                    Canvas.Top="400"/>
        </Canvas>

        <StackPanel Orientation="Vertical"
                    VerticalAlignment="Bottom"
                    Margin="0 0 8 5"
                    Grid.Column="2">
            <ui:ImageButton Content="{DynamicResource str_Select_all}"
                            DisabledImage="/EQX.UI;component/Resources/Images/Components/Common/select_normal_dark.png"
                            Image="/EQX.UI;component/Resources/Images/Components/Common/select_selected.png"
                            Command="{Binding SelectAllCommand}" FontSize="16"
                            IsEnabled="{Binding MachineStatus.IsStandByProcessMode}"/>
            <ui:ImageButton Content="{DynamicResource str_Unselect_all}"
                            DisabledImage="/EQX.UI;component/Resources/Images/Components/Common/unselect_all_normal_dark.png"
                            Image="/EQX.UI;component/Resources/Images/Components/Common/unselect_all_selected.png"
                            Command="{Binding UnSelectAllCommand}" FontSize="16"
                            IsEnabled="{Binding MachineStatus.IsStandByProcessMode}"/>
            <ui:ImageButton Content="{DynamicResource str_Origin}"
                            DisabledImage="/EQX.UI;component/Resources/Images/Components/Common/return_origin_normal.png"
                            Image="/EQX.UI;component/Resources/Images/Components/Common/return_origin_selected.png"
                            Command="{Binding OriginCommand}" FontSize="16"
                            IsEnabled="{Binding MachineStatus.IsStandByProcessMode}"/>
            <ui:ImageButton Content="{DynamicResource str_Stop}"
                            Image="/EQX.UI;component/Resources/Images/Components/Common/stop_selected.png"
                            Command="{Binding StopCommand}" FontSize="16"/>
            <ui:ImageButton Content="{DynamicResource str_Exit}"
                            DisabledImage="/EQX.UI;component/Resources/Images/Components/Common/exit_normal_dark.png"
                            Image="/EQX.UI;component/Resources/Images/Components/Common/exit_selected.png"
                            Command="{Binding ExitCommand}" FontSize="16"
                            IsEnabled="{Binding MachineStatus.IsStandByProcessMode}"/>
        </StackPanel>
    </Grid>
</UserControl>
