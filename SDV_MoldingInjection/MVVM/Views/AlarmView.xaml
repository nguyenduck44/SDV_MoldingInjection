<UserControl
    x:Class="SDV_MoldingInjection.MVVM.Views.AlarmView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
    mc:Ignorable="d"
    xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
    d:DataContext="{d:DesignInstance Type={x:Type vm:AlarmViewModel}}"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource {x:Type RadioButton}}"
               TargetType="{x:Type RadioButton}">
            <Style.Setters>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border BorderBrush="#BBDEFB"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="5"
                                    Background="{TemplateBinding Background}">
                                <Label VerticalAlignment="Center"
                                       HorizontalContentAlignment="Center"
                                       Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Setter Property="Height"
                        Value="60" />

                <Setter Property="Width"
                        Value="150" />

                <Setter Property="FontSize"
                        Value="14" />

                <Setter Property="Cursor"
                        Value="Hand" />

                <Setter Property="Background"
                        Value="#E0E0E0" />
            </Style.Setters>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#f6f8fa" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <RadioButton Content="Current Alarm"
                         Width="200"
                         FontSize="16"
                         Command="{Binding NavigateCurrentAlarmViewCommand}">
                <RadioButton.Style>
                    <Style TargetType="RadioButton"
                           BasedOn="{StaticResource {x:Type RadioButton}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentAlarmView}"
                                         Value="True">
                                <Setter Property="IsChecked"
                                        Value="True" />
                                <Setter Property="Background"
                                        Value="#4FC3F7" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RadioButton.Style>
            </RadioButton>
            <RadioButton Content="Alarm"
                         Width="200"
                         FontSize="16"
                         Command="{Binding NavigateErrorViewCommand}">
                <RadioButton.Style>
                    <Style TargetType="RadioButton"
                           BasedOn="{StaticResource {x:Type RadioButton}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorView}"
                                         Value="True">
                                <Setter Property="IsChecked"
                                        Value="True" />
                                <Setter Property="Background"
                                        Value="#4FC3F7" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RadioButton.Style>
            </RadioButton>
            <RadioButton Content="Log"
                         Width="200"
                         FontSize="16"
                         Command="{Binding NavigateLogViewCommand}">
                <RadioButton.Style>
                    <Style TargetType="RadioButton"
                           BasedOn="{StaticResource {x:Type RadioButton}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLogView}"
                                         Value="True">
                                <Setter Property="IsChecked"
                                        Value="True" />
                                <Setter Property="Background"
                                        Value="#4FC3F7" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RadioButton.Style>
            </RadioButton>
        </StackPanel>
        <ContentControl Content="{Binding CurrentVM}"
                        Margin="0 10 0 0"
                        Grid.Row="1" />
    </Grid>
</UserControl>
