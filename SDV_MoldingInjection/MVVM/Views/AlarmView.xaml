<UserControl
    x:Class="SDV_MoldingInjection.MVVM.Views.AlarmView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
    mc:Ignorable="d"
    xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
    d:DataContext="{d:DesignInstance Type={x:Type vm:AlarmViewModel}}"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="1.5*" />
            <RowDefinition
                Height="20*" />
        </Grid.RowDefinitions>

        <StackPanel
            Orientation="Horizontal">
            <RadioButton
                Content="Alarm"
                Width="200"
                FontSize="16"
                Command="{Binding NavigateErrorViewCommand}">
                <RadioButton.Style>
                    <Style
                        TargetType="RadioButton"
                        BasedOn="{StaticResource ButtonLikeRadioButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding IsErrorView}"
                                Value="True">
                                <Setter
                                    Property="IsChecked"
                                    Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RadioButton.Style>
            </RadioButton>
            <RadioButton
                Content="Log"
                Width="200"
                FontSize="16"
                Command="{Binding NavigateLogViewCommand}">
                <RadioButton.Style>
                    <Style
                        TargetType="RadioButton"
                        BasedOn="{StaticResource ButtonLikeRadioButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding IsLogView}"
                                Value="True">
                                <Setter
                                    Property="IsChecked"
                                    Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RadioButton.Style>
            </RadioButton>
        </StackPanel>
        <ContentControl
            Content="{Binding CurrentVM}"
            Margin="0 10 0 0"
            Grid.Row="1" />
    </Grid>
</UserControl>
