<UserControl
    x:Class="SDV_MoldingInjection.MVVM.Views.ErrorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
    mc:Ignorable="d"
    Loaded="UserControl_Loaded"
    xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
    d:DataContext="{d:DesignInstance Type={x:Type vm:ErrorViewModel}}"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <!-- Style dùng chung -->
            <Style x:Key="CenterText"
                   TargetType="TextBlock">
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>

            <Style x:Key="WrapText"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CenterText}">
                <Setter Property="TextWrapping"
                        Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Select Day -->
        <StackPanel Orientation="Horizontal"
                    Margin="5,0,0,0">
            <TextBlock Text="Select Day"
                       VerticalAlignment="Center" />
            <ComboBox Width="150"
                      Margin="10,0,0,0"
                      ItemsSource="{Binding LogDays}"
                      SelectedItem="{Binding SelectedDaySearch}" />
        </StackPanel>

        <!-- Error List -->
        <DataGrid Grid.Row="1"
                  Margin="5"
                  FontSize="13"
                  ItemsSource="{Binding ErrorLogEntries}"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionUnit="CellOrRowHeader"
                  SelectionMode="Extended"
                  ClipboardCopyMode="ExcludeHeader"
                  CanUserAddRows="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHightlight}"
                                     Value="True">
                            <Setter Property="Background"
                                    Value="Yellow" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Type"
                                    Binding="{Binding Type}"
                                    Width="80"
                                    ElementStyle="{StaticResource CenterText}" />

                <DataGridTextColumn Header="DateTime"
                                    Binding="{Binding Timestamp}"
                                    Width="100"
                                    SortDirection="Descending"
                                    ElementStyle="{StaticResource CenterText}" />

                <DataGridTextColumn Header="I/O"
                                    Binding="{Binding IOName}"
                                    Width="100"
                                    ElementStyle="{StaticResource WrapText}" />

                <DataGridTextColumn Header="ErrorCode"
                                    Binding="{Binding ErrorCode}"
                                    Width="100"
                                    ElementStyle="{StaticResource CenterText}" />

                <DataGridTextColumn Header="Message"
                                    Binding="{Binding Message}"
                                    Width="*"
                                    ElementStyle="{StaticResource WrapText}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Summary -->
        <DataGrid Grid.Column="1"
                  Grid.Row="1"
                  Margin="5"
                  FontSize="13"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding ErrorLogCounts}"
                  SelectedItem="{Binding SelectedErrorLogCount}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Count"
                                    Binding="{Binding Count}"
                                    Width="80"
                                    ElementStyle="{StaticResource CenterText}" />

                <DataGridTextColumn Header="I/O"
                                    Binding="{Binding IOName}"
                                    Width="100"
                                    ElementStyle="{StaticResource WrapText}" />

                <DataGridTextColumn Header="ErrorCode"
                                    Binding="{Binding ErrorCode}"
                                    Width="100"
                                    ElementStyle="{StaticResource CenterText}" />

                <DataGridTextColumn Header="Message"
                                    Binding="{Binding Message}"
                                    Width="*"
                                    ElementStyle="{StaticResource WrapText}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
