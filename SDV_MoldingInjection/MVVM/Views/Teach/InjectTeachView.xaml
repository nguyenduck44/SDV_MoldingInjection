<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.InjectTeachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             xmlns:uiControls="clr-namespace:EQX.UI.Controls;assembly=EQX.UI"
             IsEnabled="{Binding MachineStatus.IsStandByProcessMode}"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance {x:Type vm:InjectMaintenanceViewModel}}"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="{x:Type uiControls:CylinderSimpleView}">
            <Setter Property="Width"
                    Value="149" />
            <Setter Property="Height"
                    Value="70" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!--UNIT STATUS-->
        <GroupBox Header="Unit"
                  Margin="0 5 0 0"
                  DockPanel.Dock="Right">
            <ItemsControl Margin="3"
                          ItemsSource="{Binding RelatedViewModel}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding .}"
                                Command="{Binding DataContext.RelatedViewModelNavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding .}"
                                Height="40"
                                Width="130" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1"
                                     VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </GroupBox>

        <!--CURRENT UNIT TEACH VIEW-->
        <GroupBox Header="{Binding Name}"
                  Margin="0 5 5 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*" />
                    <ColumnDefinition Width="1.8*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.6*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <!-- POSITION TABLE -->
                <GroupBox Grid.ColumnSpan="2"
                          Header="{Binding SelectedGroupedPosition.Name}"
                          Style="{x:Null}"
                          FontWeight="Bold">
                    <uiControls:PositionPointGridView ItemsSource="{Binding SelectedGroupedPosition.Points}" />
                </GroupBox>
                <!-- POSITION SELECTION -->
                <GroupBox Grid.Row="1"
                          FontWeight="Bold"
                          Header="Teaching Position"
                          Style="{x:Null}">
                    <ItemsControl ItemsSource="{Binding GroupedPositions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="3"
                                        Height="50"
                                        Content="{Binding Name}"
                                        Command="{Binding DataContext.TeachingPositionButtonCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding .}">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Value="true">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource ObjectSelectedConverter}">
                                                            <Binding />
                                                            <Binding Path="DataContext.SelectedGroupedPosition"
                                                                     RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background"
                                                            Value="LightGreen" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <GroupBox Grid.Row="1"
                          Grid.Column="1"
                          FontWeight="Bold"
                          Header="Motion Moving"
                          Style="{x:Null}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.5*" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="6.7*" />
                            <RowDefinition Height="1.3*" />
                        </Grid.RowDefinitions>
                        <UniformGrid Columns="2"
                                     Margin="0 0 0 0"
                                     Height="40"
                                     VerticalAlignment="Top">
                            <Button Command="{Binding MoveToTarget}"
                                    Content="Move to Target"
                                    Margin="2 1" />
                            <Button Content="Save to Target"
                                    Command="{Binding SaveCurrentToTarget}"
                                    Margin="2 1" />
                        </UniformGrid>

                        <Button Grid.Row="1"
                                Command="{Binding StopCommand}"
                                Content="STOP" 
                                Margin="2 1"/>

                        <uiControls:IncControlView Grid.Row="2"
                                                   ItemsSource="{Binding SelectedGroupedPosition.Points}"
                                                   IncStep="{Binding IncStep, Mode=TwoWay}" />
                        <UniformGrid Grid.Row="3"
                                     Columns="2"
                                     Margin="0 5 0 0">
                            <Button Background="LightBlue"
                                    Command="{Binding TeachPositionSaveCommand}"
                                    Content="Save"
                                    Margin="2" />
                            <Button Background="Coral"
                                    Command="{Binding TeachPositionCancelCommand}"
                                    Content="Cancel"
                                    Margin="2" />
                        </UniformGrid>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1"
                          Grid.Column="2"
                          Style="{x:Null}"
                          FontWeight="Bold"
                          Grid.ColumnSpan="2"
                          Header="Cylinders">
                    <ItemsControl ItemsSource="{Binding Cylinders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </GroupBox>
            </Grid>
        </GroupBox>
    </DockPanel>
</UserControl>
