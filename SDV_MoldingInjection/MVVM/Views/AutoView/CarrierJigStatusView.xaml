<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.CarrierJigStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:SDV_MoldingInjection.Converters"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type vm:CarrierJigStatusViewModel}}"
             d:DesignHeight="300"
             d:DesignWidth="300">
    <UserControl.Resources>
        <Style x:Key="ValueCellStyle"
               TargetType="Border">
            <Setter Property="CornerRadius"
                    Value="5" />
            <Setter Property="BorderBrush"
                    Value="#4A4A4A" />
            <Setter Property="Background"
                    Value="#F2F2F2" />
            <Setter Property="Padding"
                    Value="6" />
            <Setter Property="Margin"
                    Value="2" />
        </Style>
        <Style x:Key="HighlightCellStyle"
               TargetType="Border"
               BasedOn="{StaticResource ValueCellStyle}">
            <Setter Property="Background"
                    Value="#E9EB79" />
        </Style>
        <Style x:Key="CellTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="15" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextAlignment"
                    Value="Center" />
        </Style>
        <conv:HeadSkipStatusTextConverter x:Key="HeadSkipStatusTextConverter" />
        <conv:HeadSkipStatusBrushConverter x:Key="HeadSkipStatusBrushConverter" />
    </UserControl.Resources>
    <GroupBox Header="Carrier Jig Status (mg)"
              Style="{StaticResource TextBlockHeaderGroupBox}">
        <ItemsControl ItemsSource="{Binding Heads}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   Style="{StaticResource CellTextStyle}" />
                         <TextBlock Style="{StaticResource CellTextStyle}"
                                    Text="{Binding ResinWeight, StringFormat={}{0:0.0}}" />
                        <Button Margin="0,6,0,0"
                                Height="100"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ToggleHeadSkipCommand}"
                                FontWeight="SemiBold"
                                Content="{Binding HeadSkip, Converter={StaticResource HeadSkipStatusTextConverter}}"
                                Background="{Binding HeadSkip, Converter={StaticResource HeadSkipStatusBrushConverter}}" />
                        <TextBlock Style="{StaticResource CellTextStyle}"
                                       Text="Timer" />
                        <TextBlock Style="{StaticResource CellTextStyle}"
                                    Text="{Binding ResinTimer, StringFormat={}{0:0.0} s}" />
                        <TextBlock Style="{StaticResource CellTextStyle}"
                                       Text="Vel-P" />
                        <TextBlock Style="{StaticResource CellTextStyle}"
                                       Text="{Binding PAxisInjectVel, StringFormat={}{0:0.0}}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </GroupBox>
</UserControl>
