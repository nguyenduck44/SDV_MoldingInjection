<UserControl x:Class="SDV_MoldingInjection.MVVM.Views.CurrentAlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDV_MoldingInjection.MVVM.Views"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:SDV_MoldingInjection.MVVM.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type vm:CurrentAlarmViewModel}}"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <!-- Style dùng chung -->
            <Style x:Key="CenterText"
                   TargetType="TextBlock">
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>

            <Style x:Key="WrapText"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CenterText}">
                <Setter Property="TextWrapping"
                        Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <GroupBox Header="Light Alarm"
                  Margin="5">
            <DataGrid Margin="5"
                      FontSize="13"
                      ItemsSource="{Binding MachineStatus.CurrentAlarms}"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      SelectionUnit="CellOrRowHeader"
                      SelectionMode="Extended"
                      ClipboardCopyMode="ExcludeHeader"
                      CanUserAddRows="False">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHightlight}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="Yellow" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding Type}"
                                        Width="80"
                                        ElementStyle="{StaticResource CenterText}" />

                    <DataGridTextColumn Header="I/O"
                                        Binding="{Binding IOName}"
                                        Width="100"
                                        ElementStyle="{StaticResource WrapText}" />

                    <DataGridTextColumn Header="ErrorCode"
                                        Binding="{Binding ErrorCode}"
                                        Width="100"
                                        ElementStyle="{StaticResource CenterText}" />

                    <DataGridTextColumn Header="Message"
                                        Binding="{Binding Message}"
                                        Width="*"
                                        ElementStyle="{StaticResource WrapText}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox Header="Heavy Alarm"
                  Margin="5"
                  Grid.Row="1">
            <DataGrid Margin="5"
                      FontSize="13"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      SelectionUnit="CellOrRowHeader"
                      SelectionMode="Extended"
                      ClipboardCopyMode="ExcludeHeader"
                      CanUserAddRows="False">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHightlight}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="Yellow" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding Type}"
                                        Width="80"
                                        ElementStyle="{StaticResource CenterText}" />

                    <DataGridTextColumn Header="I/O"
                                        Binding="{Binding IOName}"
                                        Width="100"
                                        ElementStyle="{StaticResource WrapText}" />

                    <DataGridTextColumn Header="ErrorCode"
                                        Binding="{Binding ErrorCode}"
                                        Width="100"
                                        ElementStyle="{StaticResource CenterText}" />

                    <DataGridTextColumn Header="Message"
                                        Binding="{Binding Message}"
                                        Width="*"
                                        ElementStyle="{StaticResource WrapText}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <StackPanel Grid.Column="1"
                    Grid.RowSpan="2"
                    Margin="5">
            <Button Content="Alarm Reset"
                    FontSize="16"
                    Width="200"
                    Height="50"
                    Command="{Binding AlarmResetCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
