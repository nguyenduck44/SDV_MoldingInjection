<UserControl x:Class="SDV_MoldingInjection.Resource.Controls.SingleAxisSpeedConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDV_MoldingInjection.Resource.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <Style TargetType="{x:Type Border}">
                <Style.Setters>
                    <!--<Setter Property="BorderBrush"
                            Value="Gray" />
                    <Setter Property="BorderThickness"
                            Value="0.5" />-->
                </Style.Setters>
            </Style>

            <Style TargetType="{x:Type TextBox}">
                <Style.Setters>
                    <Setter Property="IsReadOnly"
                            Value="True" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Center" />
                    <Setter Property="HorizontalContentAlignment"
                            Value="Center" />
                    <Setter Property="FontSize"
                            Value="14" />
                    <EventSetter Event="PreviewMouseUp"
                                 Handler="TextBox_MouseUp" />
                </Style.Setters>
            </Style>
        </Grid.Resources>

        <Border BorderBrush="Gray"
                BorderThickness="0.8">
            <Label Content="{Binding AxisName}"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"
                   FontWeight="Bold"
                   FontSize="14" />
        </Border>
        <Border Grid.Column="1">
            <TextBox Text="{Binding Speed ,UpdateSourceTrigger=PropertyChanged}" />
        </Border>
        <Border Grid.Column="2">
            <TextBox Text="{Binding Accel , UpdateSourceTrigger=PropertyChanged}" />
        </Border>
        <Border Grid.Column="3">
            <TextBox Text="{Binding Decel , UpdateSourceTrigger=PropertyChanged}" />
        </Border>
    </Grid>
</UserControl>
