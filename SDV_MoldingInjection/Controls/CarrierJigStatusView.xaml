<UserControl x:Class="SDV_MoldingInjection.Controls.CarrierJigStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDV_MoldingInjection.Controls"
             mc:Ignorable="d"
             xmlns:conv="clr-namespace:SDV_MoldingInjection.Converters"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="ValueCellStyle"
               TargetType="Border">
            <Setter Property="CornerRadius"
                    Value="5" />
            <Setter Property="BorderBrush"
                    Value="#4A4A4A" />
            <Setter Property="Background"
                    Value="#F2F2F2" />
            <Setter Property="Padding"
                    Value="6" />
            <Setter Property="Margin"
                    Value="2" />
        </Style>
        <Style x:Key="HighlightCellStyle"
               TargetType="Border"
               BasedOn="{StaticResource ValueCellStyle}">
            <Setter Property="Background"
                    Value="#E9EB79" />
        </Style>
        <Style x:Key="CellTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="10" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextAlignment"
                    Value="Center" />
        </Style>
        <conv:HeadSkipStatusTextConverter x:Key="HeadSkipStatusTextConverter" />
        <conv:HeadSkipStatusBrushConverter x:Key="HeadSkipStatusBrushConverter" />
    </UserControl.Resources>
    <Grid>
        <StackPanel>
            <TextBlock Text="{Binding Name}"
                       Style="{StaticResource CellTextStyle}" />
            <TextBlock Style="{StaticResource CellTextStyle}"
                       Text="{Binding ResinWeight}" />
            <Button Margin="0,6,0,0"
                    Height="100"
                    Click="Button_Click"
                    HorizontalAlignment="Stretch"
                    FontWeight="SemiBold"
                    Content="{Binding HeadSkip, Converter={StaticResource HeadSkipStatusTextConverter}}"
                    Background="{Binding HeadSkip, Converter={StaticResource HeadSkipStatusBrushConverter}}" />
            <TextBlock Style="{StaticResource CellTextStyle}"
                       Text="Timer" />
            <TextBlock Style="{StaticResource CellTextStyle}"
                       Text="{Binding InjectTime, StringFormat={}{0:0.00} s}"
                       Margin="0 0 0 10" />
            <TextBlock Style="{StaticResource CellTextStyle}"
                       Text="Vel-P" />
            <TextBlock Style="{StaticResource CellTextStyle}"
                       Text="{Binding PAxisInjectVelocity, StringFormat={}{0:0.00}}" />
        </StackPanel>
    </Grid>
</UserControl>
