<UserControl x:Class="SDV_MoldingInjection.Controls.SyringeUnitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_MoldingInjection.Controls"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="80">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding SyringeAmountStatus.RemainVolume, StringFormat=F3,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="2"/>

        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border x:Name="TubeBackground"
                    Width="40"
                    Height="120"
                    CornerRadius="12"
                    Background="#FFE5E5E5"
                    BorderBrush="#FFB0B0B0"
                    MouseUp="Border_MouseUp"
                    BorderThickness="1">
                <Grid>
                    <Border Width="40"
                            CornerRadius="12"
                            VerticalAlignment="Bottom"
                            Height="{Binding SyringeAmountStatus.RemainPercent,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Border.Style>
                                <Style TargetType="Border">
                                <Setter Property="Background" Value="#1E90FF" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="SyringeAmountStatus.IsTimeOver"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="Brown" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding ElapsedTime, StringFormat='{}{0:hh\\:mm\\:ss}',
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="13" />
    </Grid>
</UserControl>
