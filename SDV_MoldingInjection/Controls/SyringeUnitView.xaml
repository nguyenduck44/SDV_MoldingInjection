<UserControl x:Class="SDV_MoldingInjection.Controls.SyringeUnitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_MoldingInjection.Controls"
             xmlns:conv="clr-namespace:SDV_MoldingInjection.Converters"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="80">
    <UserControl.Resources>
        <conv:TimeSpanToTotalHoursStringConverter x:Key="TimeSpanToTotalHoursStringConverter" />

        <Style x:Key="HeadTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeadAvailable}" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                    <Setter Property="Text" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding RemainVolume, StringFormat=F3}"
                   Style="{StaticResource HeadTextBlockStyle}"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="2 5"/>

        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border x:Name="TubeBackground"
                    Width="40"
                    Height="120"
                    CornerRadius="12"
                    Background="#FFE5E5E5"
                    BorderBrush="#FFB0B0B0"
                    MouseUp="Border_MouseUp"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="#FFE5E5E5" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHeadAvailable}"
                                         Value="False">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Setter Property="Opacity"
                                        Value="0.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Border Width="40"
                            CornerRadius="12"
                            VerticalAlignment="Bottom"
                            Height="{Binding RemainPercent}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="#1E90FF" />
                                <Style.Triggers>
                                    <DataTrigger Value="True"
                                                 Binding="{Binding IsTimeOver}">
                                        <Setter Property="Background"
                                                Value="Brown" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHeadAvailable}"
                                                 Value="False">
                                        <Setter Property="Background"
                                                Value="Transparent" />
                                        <Setter Property="Height"
                                                Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding ElapsedTime, Converter={StaticResource TimeSpanToTotalHoursStringConverter}}"
                   Style="{StaticResource HeadTextBlockStyle}"
                   FontSize="14"/>
    </Grid>
</UserControl>
