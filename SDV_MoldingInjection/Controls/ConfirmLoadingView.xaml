<Window x:Class="SDV_MoldingInjection.Controls.ConfirmLoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SDV_MoldingInjection.Controls"
             mc:Ignorable="d"
             xmlns:ui="clr-namespace:EQX.UI.Controls;assembly=EQX.UI" 
             Width="741"
             Height="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Confirm Loading Finish"
                   FontWeight="Bold"
                   FontSize="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Width="300"
                    Height="50"
                    Grid.Row="1">
            <ui:ImageButton Content="Exit"
                            Margin="10 0"
                            Width="130"
                            Image="{StaticResource image_exit_normal_light}"
                            Click="ButtonExit_Click"/>
            <ui:ImageButton Content="Confirm"
                            Width="130"
                            Image="{StaticResource image_ok_selected}"
                            Background="LightGreen"
                            Click="ButtonConfirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
