<UserControl x:Class="SDV_MoldingInjection.Controls.ProductionDayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_MoldingInjection.Controls"
             mc:Ignorable="d"
             xmlns:production="clr-namespace:SDV_MoldingInjection.Defines.Productions"
             d:DataContext="{d:DesignInstance Type={x:Type production:ProductionDayItem}}"
             d:DesignHeight="600"
             d:DesignWidth="800">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TableBorderBrush"
                         Color="#bfbfbf" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush"
                         Color="#d9d9d9" />
        <SolidColorBrush x:Key="InactiveTabBrush"
                         Color="#f2f2f2" />
        <SolidColorBrush x:Key="ActiveTabBrush"
                         Color="#18ff00" />

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"
                    Value="False" />
            <Setter Property="CanUserReorderColumns"
                    Value="False" />
            <Setter Property="CanUserSortColumns"
                    Value="False" />
            <Setter Property="CanUserResizeColumns"
                    Value="False" />
            <Setter Property="CanUserAddRows"
                    Value="False" />
            <Setter Property="CanUserDeleteRows"
                    Value="False" />
            <Setter Property="IsReadOnly"
                    Value="True" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="RowHeaderWidth"
                    Value="0" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource TableBorderBrush}" />
            <Setter Property="HorizontalGridLinesBrush"
                    Value="{StaticResource TableBorderBrush}" />
            <Setter Property="VerticalGridLinesBrush"
                    Value="{StaticResource TableBorderBrush}" />
            <Setter Property="HeadersVisibility"
                    Value="Column" />
            <Setter Property="GridLinesVisibility"
                    Value="All" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="Margin"
                    Value="0" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="{StaticResource HeaderBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="#111111" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="6,8" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource TableBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="0,0,1,1" />
        </Style>

        <!-- Summary grid style -->
        <Style x:Key="SumLabelKey"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#636e72" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="4,0,0,0" />
        </Style>

        <Style x:Key="SumValueStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#2d3436" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="HorizontalAlignment"
                    Value="Right" />
            <Setter Property="Margin"
                    Value="0,0,6,0" />
        </Style>

        <Style x:Key="SumNGStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#d63031" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="HorizontalAlignment"
                    Value="Right" />
            <Setter Property="Margin"
                    Value="0,0,6,0" />
        </Style>

        <Style x:Key="DataGridCellTextStyle"
               TargetType="TextBlock">
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Foreground"
                    Value="#111111" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="FontSize"
                    Value="15" />
            <Setter Property="TextAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="0,6" />
        </Style>

        <Style x:Key="SideTitleStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Foreground"
                    Value="#111111" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="0,4,0,8" />
        </Style>

        <Style x:Key="SummaryBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource TableBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="CornerRadius"
                    Value="0" />
            <Setter Property="Margin"
                    Value="0,4,0,0" />
            <Setter Property="Padding"
                    Value="6,6" />
        </Style>

        <Style x:Key="ShiftTabRadioButtonStyle"
               TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="#111111" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Height"
                    Value="30" />
            <Setter Property="MinWidth"
                    Value="145" />
            <Setter Property="Margin"
                    Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Background="{StaticResource InactiveTabBrush}"
                                BorderBrush="{StaticResource TableBorderBrush}"
                                BorderThickness="1"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="RootBorder"
                                        Property="Background"
                                        Value="{StaticResource ActiveTabBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatGroupBoxStyle"
               TargetType="GroupBox">
            <Setter Property="BorderBrush"
                    Value="{StaticResource TableBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="Padding"
                    Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        Background="{StaticResource HeaderBackgroundBrush}"
                                        BorderBrush="{StaticResource TableBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,6">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="6"
          Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <RadioButton x:Name="AllShiftRadioButton"
                         Content="All Shift"
                         GroupName="ShiftViewMode"
                         IsChecked="True"
                         Style="{StaticResource ShiftTabRadioButtonStyle}"
                         Checked="ShiftViewRadioButton_Checked" />
            <RadioButton x:Name="DayShiftRadioButton"
                         Content="Day Shift (8:00 ~ 20:00)"
                         GroupName="ShiftViewMode"
                         Style="{StaticResource ShiftTabRadioButtonStyle}"
                         Checked="ShiftViewRadioButton_Checked" />
            <RadioButton x:Name="NightShiftRadioButton"
                         Content="Night Shift (20:00 ~ 8:00)"
                         GroupName="ShiftViewMode"
                         Style="{StaticResource ShiftTabRadioButtonStyle}"
                         Checked="ShiftViewRadioButton_Checked" />
        </StackPanel>

        <Grid x:Name="ShiftContentGrid"
              Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="6" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════ ALL SHIFT ═══════════════════ -->
            <GroupBox x:Name="AllShiftGroupBox"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Padding="4"
                      Style="{StaticResource FlatGroupBoxStyle}">
                <GroupBox.Header>
                    <TextBlock Text="All Shift"
                               FontWeight="Bold"
                               Foreground="#111111"
                               FontSize="13" />
                </GroupBox.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="◀  LEFT"
                                   Style="{StaticResource SideTitleStyle}" />

                        <Border DockPanel.Dock="Bottom"
                                Style="{StaticResource SummaryBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Input"
                                           Style="{StaticResource SumLabelKey}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding TotalInputLeft}"
                                           Style="{StaticResource SumValueStyle}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Output"
                                           Style="{StaticResource SumLabelKey}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding TotalOutputLeft}"
                                           Style="{StaticResource SumValueStyle}" />
                            </Grid>
                        </Border>

                        <DataGrid ItemsSource="{Binding AllShiftLeft}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hour"
                                                    Binding="{Binding Hour , StringFormat={}{0:00}h}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                <DataGridTextColumn Header="Input"
                                                    Binding="{Binding InputCount}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                <DataGridTextColumn Header="Output"
                                                    Binding="{Binding OutputCount}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="RIGHT  ▶"
                                   Style="{StaticResource SideTitleStyle}" />

                        <Border DockPanel.Dock="Bottom"
                                Style="{StaticResource SummaryBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Input"
                                           Style="{StaticResource SumLabelKey}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding TotalInputRight}"
                                           Style="{StaticResource SumValueStyle}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Output"
                                           Style="{StaticResource SumLabelKey}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding TotalOutputRight}"
                                           Style="{StaticResource SumValueStyle}" />
                            </Grid>
                        </Border>

                        <DataGrid ItemsSource="{Binding AllShiftRight}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hour"
                                                    Binding="{Binding Hour , StringFormat={}{0:00}h}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                <DataGridTextColumn Header="Input"
                                                    Binding="{Binding InputCount}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                <DataGridTextColumn Header="Output"
                                                    Binding="{Binding OutputCount}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </GroupBox>

            <!-- ═══════════════════ SHIFT DAY ═══════════════════ -->
            <GroupBox x:Name="DayShiftGroupBox"
                      Grid.Column="0"
                      Padding="4"
                      Style="{StaticResource FlatGroupBoxStyle}">
                <GroupBox.Header>
                    <TextBlock Text="Shift Day  (08:00 – 20:00)"
                               FontWeight="Bold"
                               Foreground="#111111"
                               FontSize="13" />
                </GroupBox.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!-- ── Left / Day ── -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="◀  LEFT"
                                   Style="{StaticResource SideTitleStyle}" />

                        <Border DockPanel.Dock="Bottom"
                                Style="{StaticResource SummaryBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Input"
                                           Style="{StaticResource SumLabelKey}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding TotalInputLeftShiftDay}"
                                           Style="{StaticResource SumValueStyle}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Output"
                                           Style="{StaticResource SumLabelKey}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding TotalOutputLeftShiftDay}"
                                           Style="{StaticResource SumValueStyle}" />
                            </Grid>
                        </Border>

                        <DataGrid ItemsSource="{Binding ShiftDayLeft}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hour"
                                                    Binding="{Binding Hour , StringFormat={}{0:00}h}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                <DataGridTextColumn Header="Input"
                                                    Binding="{Binding InputCount}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                <DataGridTextColumn Header="Output"
                                                    Binding="{Binding OutputCount}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- ── Right / Day ── -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="RIGHT  ▶"
                                   Style="{StaticResource SideTitleStyle}" />

                        <Border DockPanel.Dock="Bottom"
                                Style="{StaticResource SummaryBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Input"
                                           Style="{StaticResource SumLabelKey}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding TotalInputRightShiftDay}"
                                           Style="{StaticResource SumValueStyle}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Output"
                                           Style="{StaticResource SumLabelKey}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding TotalOutputRightShiftDay}"
                                           Style="{StaticResource SumValueStyle}" />
                            </Grid>
                        </Border>

                        <DataGrid ItemsSource="{Binding ShiftDayRight}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hour"
                                                    Binding="{Binding Hour , StringFormat={}{0:00}h}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                <DataGridTextColumn Header="Input"
                                                    Binding="{Binding InputCount}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                <DataGridTextColumn Header="Output"
                                                    Binding="{Binding OutputCount}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </GroupBox>

            <!-- ═══════════════════ SHIFT NIGHT ═══════════════════ -->
            <GroupBox x:Name="NightShiftGroupBox"
                      Grid.Column="2"
                      Padding="4"
                      Style="{StaticResource FlatGroupBoxStyle}">
                <GroupBox.Header>
                    <TextBlock Text="Shift Night  (20:00 – 08:00)"
                               FontWeight="Bold"
                               Foreground="#111111"
                               FontSize="13" />
                </GroupBox.Header>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!-- ── Left / Night ── -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="◀  LEFT"
                                   Style="{StaticResource SideTitleStyle}" />

                        <Border DockPanel.Dock="Bottom"
                                Style="{StaticResource SummaryBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Input"
                                           Style="{StaticResource SumLabelKey}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding TotalInputLeftShiftNight}"
                                           Style="{StaticResource SumValueStyle}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Output"
                                           Style="{StaticResource SumLabelKey}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding TotalOutputLeftShiftNight}"
                                           Style="{StaticResource SumValueStyle}" />
                            </Grid>
                        </Border>

                        <DataGrid ItemsSource="{Binding ShiftNightLeft}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hour"
                                                    Binding="{Binding Hour , StringFormat={}{0:00}h}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                <DataGridTextColumn Header="Input"
                                                    Binding="{Binding InputCount}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                <DataGridTextColumn Header="Output"
                                                    Binding="{Binding OutputCount}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- ── Right / Night ── -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="RIGHT  ▶"
                                   Style="{StaticResource SideTitleStyle}" />

                        <Border DockPanel.Dock="Bottom"
                                Style="{StaticResource SummaryBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Input"
                                           Style="{StaticResource SumLabelKey}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding TotalInputRightShiftNight}"
                                           Style="{StaticResource SumValueStyle}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Output"
                                           Style="{StaticResource SumLabelKey}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding TotalOutputRightShiftNight}"
                                           Style="{StaticResource SumValueStyle}" />
                            </Grid>
                        </Border>

                        <DataGrid ItemsSource="{Binding ShiftNightRight}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hour"
                                                    Binding="{Binding Hour , StringFormat={}{0:00}h}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                <DataGridTextColumn Header="Input"
                                                    Binding="{Binding InputCount}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                <DataGridTextColumn Header="Output"
                                                    Binding="{Binding OutputCount}"
                                                    Width="*"
                                                    ElementStyle="{StaticResource DataGridCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </GroupBox>
        </Grid>

    </Grid>
</UserControl>
