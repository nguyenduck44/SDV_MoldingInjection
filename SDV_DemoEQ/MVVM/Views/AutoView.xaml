<UserControl x:Class="SDV_DemoEQ.MVVM.Views.AutoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SDV_DemoEQ.MVVM.Views"
             xmlns:defines="clr-namespace:SDV_DemoEQ.Defines"
             xmlns:cvt="clr-namespace:SDV_DemoEQ.Converters"
             mc:Ignorable="d"
             x:Name="root"
             xmlns:vm="clr-namespace:SDV_DemoEQ.MVVM.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type vm:AutoViewModel}}"
             xmlns:ui="clr-namespace:EQX.UI.Controls;assembly=EQX.UI"
             d:DesignHeight="1060"
             d:DesignWidth="1920">
    <UserControl.Resources>
        <Style TargetType="Border">
            <Setter Property="BorderThickness"
                    Value="2" />
            <Setter Property="BorderBrush"
                    Value="LightGray" />
            <Setter Property="CornerRadius"
                    Value="5" />
            <Setter Property="Cursor"
                    Value="Hand" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="FontSize"
                    Value="14" />
        </Style>
        <Style
            TargetType="{x:Type ui:ImageButton}"
            BasedOn="{StaticResource {x:Type ui:ImageButton}}">
            <Setter Property="FontSize" Value="22" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    
    <Grid Margin="10 0 0 0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Machine Image -->
        <Image Grid.Column="1"
            Source="/SDV_DemoEQ;component/Resource/Images/DotDispenser_TopView.png"
            Margin="120"/>

        <Grid Grid.Column="2"
              Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <UniformGrid Columns="1">
                <Label Content="{DynamicResource str_Machine_Status}"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       FontSize="16"
                       Margin="0 0 0 5"
                       FontWeight="Bold"
                       Foreground="Wheat"
                       Background="{StaticResource SecondaryBackgroundColor}" />
                <Label Content="{Binding MachineStatus.CurrentProcessMode}"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center"
                       Typography.Capitals="AllPetiteCaps"
                       Background="AliceBlue" />
                <ComboBox Margin="2 0"
                          Tag="Language"
                          FontSize="16"
                          Height="40"
                          ItemsSource="{Binding Cultures}"
                          SelectedValue="{Binding RecipeSelector.CurrentRecipe.CommonRecipe.SelectedLanguage, Mode=TwoWay}" />
            </UniformGrid>

            <UniformGrid
                Columns="1" Grid.Row="1"
                Height="500"
                VerticalAlignment="Bottom">
                <ui:ImageRadioButton
                    Image="/EQX.UI;component/Resources/Images/Components/Common/auto_selected.png"
                    DisabledImage="/EQX.UI;component/Resources/Images/Components/Common/auto_normal_light.png"
                    Content="{DynamicResource str_AutoMode}"
                    FontSize="22"/>

                <ui:ImageRadioButton
                    Image="/EQX.UI;component/Resources/Images/Components/Common/manual_selected.png"
                    DisabledImage="/EQX.UI;component/Resources/Images/Components/Common/manual_normal_light.png"
                    Content="{DynamicResource str_ManualMode}"
                    FontSize="22"/>

                <ui:ImageButton
                    Image="/EQX.UI;component/Resources/Images/Components/Common/model_change_Selected.png"
                    Content="{DynamicResource str_AutoRun}"
                    Command="{Binding StartCommand}"
                    IsEnabled="{Binding MachineStatus.IsStandByProcessMode}" />

                <ui:ImageButton
                    Image="/EQX.UI;component/Resources/Images/Components/Common/stop_selected.png"
                    Content="{DynamicResource str_CycleStop}"
                    Command="{Binding StopCommand}" />

                <ui:ImageButton
                    Image="/EQX.UI;component/Resources/Images/Components/Common/pause_selected.png"
                    Content="{DynamicResource str_Pause}"
                    Command="{Binding StopCommand}" />

                <ui:ImageButton
                    Image="/EQX.UI;component/Resources/Images/Components/Common/return_origin_selected.png"
                    Content="{DynamicResource str_Origin}"
                    Command="{Binding OriginCommand}"
                    IsEnabled="{Binding MachineStatus.IsStandByProcessMode}" />

            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
